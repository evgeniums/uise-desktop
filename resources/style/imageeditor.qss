uise--SimpleImageEditorWidget uise--PushButton QPushButton,
uise--ImageViewerWidget uise--PushButton QPushButton{
padding: 4px 8px 4px 4px;
icon-size:24px;
}

uise--SimpleImageEditorWidget uise--PushButton {
}

uise--SimpleImageEditorWidget #controlsFrame {
padding:2px;
}

uise--SimpleImageEditorWidget #freeHandDrawFrame {
border-radius: 4px;
}

uise--SimpleImageEditorWidget #freeHanPenWidth{
margin-right: 4px;
}

uise--SimpleImageEditorWidget #freeHandColor
{
margin-right: 8px;
min-height: 20px;
}

uise--SimpleImageEditorWidget #mainButtonsFrame,
uise--ImageViewerWidget #mainButtonsFrame{
padding-top:4px;
padding-bottom:4px;
}

uise--SimpleImageEditorWidget #fileBrowserFrame uise--PushButton,
uise--DirectoryImagesViewer #fileBrowserFrame uise--PushButton{
margin-left: 4px;
}

uise--SimpleImageEditorWidget #fileBrowserFrame uise--PushButton QPushButton,
uise--DirectoryImagesViewer #fileBrowserFrame uise--PushButton QPushButton{
border-radius: 4px; padding: 2px 12px;
}

uise--SimpleImageEditorWidget #fileBrowserFrame QLineEdit,
uise--DirectoryImagesViewer #fileBrowserFrame QLineEdit{
padding: 2px;
}

uise--DirectoryImagesViewer {
padding: 8px;
}

uise--DirectoryImagesViewer #fileBrowserFrame
{
margin-top: 4px;
}

/* Left/right values here become the prev/next JumpEdge buttons' own left/right inset from the
 * view's edge (see ImageViewerWidget::updateButtonPositions()) -- increased from the original
 * 8px so the buttons sit clear of the wider edge navigation click/hover zones (see
 * ImageViewerWidget::isInPrevNavigationZone()/isInNextNavigationZone()) rather than flush
 * against the image edge. */
uise--ImageViewerWidget #viewerStyleSample {
margin: 0 24px;
}
