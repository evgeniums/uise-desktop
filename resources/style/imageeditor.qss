uise--SimpleImageEditorWidget uise--PushButton QPushButton,
uise--ImageViewerWidget uise--PushButton QPushButton{
margin-right:4px;
padding:4px;
icon-size:24px;
}

/* margin-right:4px above grows each inner QPushButton's own rect() 4px wider on the right --
 * rippleInsetRight compensates, keeping this in step with the margin above. */
uise--SimpleImageEditorWidget uise--PushButton QPushButton uise--RippleOverlay,
uise--ImageViewerWidget uise--PushButton QPushButton uise--RippleOverlay{
qproperty-rippleInsetRight: 4;
}

uise--SimpleImageEditorWidget uise--PushButton {
}

uise--SimpleImageEditorWidget #controlsFrame {
padding:2px;
}

uise--SimpleImageEditorWidget #freeHandDrawFrame {
border-radius: 4px;
}

uise--SimpleImageEditorWidget #freeHanPenWidth{
margin-right: 4px;
}

uise--SimpleImageEditorWidget #freeHandColor
{
margin-right: 8px;
min-height: 20px;
}

uise--SimpleImageEditorWidget #mainButtonsFrame,
uise--ImageViewerWidget #mainButtonsFrame{
padding-top:4px;
padding-bottom:4px;
}

uise--SimpleImageEditorWidget #fileBrowserFrame uise--PushButton QPushButton,
uise--DirectoryImagesViewer #fileBrowserFrame uise--PushButton QPushButton{
border-radius: 4px; padding: 2px 12px; margin-left: 4px;
}

/* margin-left:4px above adds a left margin on top of the general uise--PushButton rule above
 * -- rippleInsetLeft compensates here; SimpleImageEditorWidget's fileBrowserFrame buttons also
 * match the general rule's margin-right:4px/rippleInsetRight:4 above (DirectoryImagesViewer's
 * do not, since it isn't in that rule's selector), so the two blocks combine correctly for
 * each. Keep in step with the margins above. */
uise--SimpleImageEditorWidget #fileBrowserFrame uise--PushButton QPushButton uise--RippleOverlay,
uise--DirectoryImagesViewer #fileBrowserFrame uise--PushButton QPushButton uise--RippleOverlay{
qproperty-rippleInsetLeft: 4;
}

uise--SimpleImageEditorWidget #fileBrowserFrame QLineEdit,
uise--DirectoryImagesViewer #fileBrowserFrame QLineEdit{
padding: 2px;
}

uise--DirectoryImagesViewer {
padding: 8px;
}

uise--DirectoryImagesViewer #fileBrowserFrame
{
margin-top: 4px;
}

uise--ImageViewerWidget #viewerStyleSample {
margin: 0 8px;
}
