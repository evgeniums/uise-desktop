/* Layout and metrics for AudioDeviceSetting (theme-neutral). */

uise--AudioDeviceSetting #deviceRow,
uise--AudioDeviceSetting #defaultRow,
uise--AudioDeviceSetting #testRow
{
    margin: 0;
    padding: 0;
    margin-bottom: 6px;
}

uise--AudioDeviceSetting #commentLabel
{
    margin: 0;
    padding: 0;
    margin-bottom: 3px;
}

uise--AudioDeviceSetting #testRow
{
    padding-right: 2px;
}

/* Device-type indicator button: svg only, no border/background. */
uise--AudioDeviceSetting #typeButton QPushButton
{
    border: none;
    background-color: transparent;
    padding: 0;
    margin: 0;
    margin-right: 6px;
    icon-size: 28px;
}

/* margin-right:6px above grows this inner QPushButton's own rect() 6px wider on the right --
 * rippleInsetRight compensates, keeping this in step with the margin above. */
uise--AudioDeviceSetting #typeButton QPushButton uise--RippleOverlay
{
    qproperty-rippleInsetRight: 6;
}

uise--AudioDeviceSetting #deviceCombo
{
    min-width: 160px;
}

uise--AudioDeviceSetting #defaultName
{
    margin-left: 2px;
}

uise--AudioDeviceSetting #testButton QPushButton,
uise--AudioDeviceSetting #testButton
{
    border:none;
    padding:0;
}

uise--AudioDeviceSetting #testButton
{
    margin-left:2px;
    margin-right:4px;
}

/* margin-left:2px/margin-right:4px above grow this PushButton's own rect() on both sides --
 * rippleInsetLeft/Right compensate, keeping this in step with the margin above. testButton is
 * checkable (see audiodevicesetting.cpp), which normally disables the ripple entirely, but the
 * insets are kept correct here so nothing needs revisiting if that ever changes. */
uise--AudioDeviceSetting #testButton uise--RippleOverlay
{
    qproperty-rippleInsetLeft: 2;
    qproperty-rippleInsetRight: 4;
}

/* Dashed (chunked) volume meter: separate segments via chunk width + margin. */
uise--AudioDeviceSetting #volumeBar
{
    min-height: 12px;
    max-height: 12px;
    border: none;
    padding: 0;
}

uise--AudioDeviceSetting #volumeBar::chunk
{
    width: 6px;
    margin: 1px;
}
