uise--ChatMessageFiles,
uise--ChatMessageImages {
padding:0;
margin:0;
margin-bottom:4px;
}

/* Hard cap on the bubble width of a file message -- same idea as chat.qss's
 * qproperty-maxBubbleWidth on uise--AbstractChatMessageText: a row's width otherwise tracks its
 * file name's full, unelided length. 0 disables the cap. */
uise--ChatMessageFiles {
qproperty-maxBubbleWidth: 600;
}

uise--ChatMessageFiles #contents {
padding:0;
margin:0;
}

/* todo-album-layout-small-tile-packing.md: floor a small image's album tile is scaled up to,
 * aspect preserved, instead of being left genuinely tiny (Telegram-style) -- and the paint-time
 * upscale allowance that lets a tile actually reach that floor (2.5x covers a source down to
 * ~80px on a DPR-2 display). See ChatMessageImages::minTileSize()/tileMaxUpscale()'s own doc
 * comments. Both default to these same values in code; restated here as the QSS-overridable knob. */
uise--ChatMessageImages {
qproperty-minTileSize: 100;
qproperty-tileMaxUpscale: 2.5;
}

uise--ChatMessageFileItem {
border-radius:8px;
padding:4px 0;
}

uise--ChatMessageFileItem #iconSlot {
padding:0;
margin:0;
}

uise--ChatMessageFileItem #textColumn {
padding:0;
margin-left:8px;
margin-right:8px;
}

/* same left edge as nameLabel above it -- no margin-left of its own, so the two lines stay
   flush on the left boundary; textColumn's own margin-left:8px already positions both */
uise--ChatMessageFileItem #infoLabel {
font-size:11px;
}

/* IconTextButton's icon has no sensible default size of its own -- it must be set explicitly
   per container, same as fileupload.qss/dropdownmenu.qss do for their own icon buttons */
uise--ChatMessageFileItem uise--IconTextButton uise--RoundedImage,
uise--ChatMessageImageItem uise--IconTextButton uise--RoundedImage {
min-width:18px;
max-width:18px;
min-height:18px;
max-height:18px;
}

uise--ChatMessageFileItem uise--IconTextButton,
uise--ChatMessageImageItem uise--IconTextButton {
padding:4px;
border-radius:4px;
border:1px solid transparent;
}

uise--ChatMessageImageItem {
border-radius:8px;
}

/* Placeholder tile: an image item with no content to show at all -- a preview that never
   resolved, or a failed/synthesized entry with no image behind it. Rendered as an empty
   rounded outline rather than a filled fallback glyph: the tile already carries a centered
   load control and a floating menu button, and an icon behind those read as visual noise.
   Border color is picked per theme in dark/light.qss. */
uise--ChatMessageImageItem[placeholder="true"] {
border-width: 3px;
border-style: solid;
border-radius: 8px;
}

/* the menu button floats over arbitrary photo content, same rationale as fileupload.qss's
   [view="image"] #itemButtons -- it always gets a translucent backing so the (theme-colored)
   icon stays visible against arbitrary photo content; color picked per theme in dark/light.qss */
uise--ChatMessageImageItem #menuButton {
border-radius:6px;
padding:4px;
}
