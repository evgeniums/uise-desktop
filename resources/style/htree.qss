uise--HTree #hTreeSplitterScArea {border:none;}

uise--HTreeNode {padding:0;margin:0;}
uise--HTreeNodeTitleBar QPushButton {margin:0;padding:4px 0;border:none;icon-size:16px;}
uise--HTreeNodeTitleBar uise--ElidedLabel {margin:0;}
uise--HTreeNodeTitleBar uise--ElidedLabel QLabel {font-size: 14px;}
uise--HTreeNodeTitleBar {
    border-right:none;
    border-left:none;
    padding:0;
    margin:0;
}

uise--HTreeNodePlaceHolder {min-width:8px;max-width:8px;padding: 0 1px;}
uise--HTreeNodePlaceHolder QPushButton {border:none;icon-size: 20px 6px;}

uise--HTreeStandardListItem #hTreeItemPixmap QPushButton {
    margin-right:4px;
    padding:4px;
    icon-size:24px;
}

/* margin-right:4px above grows this inner QPushButton's own rect() 4px wider on the right --
 * rippleInsetRight compensates, keeping this in step with the margin above. hTreeItemPixmap is
 * checkable (see htreestandardlistitem.cpp), which normally disables the ripple entirely, but
 * the inset is kept correct here so nothing needs revisiting if that ever changes. */
uise--HTreeStandardListItem #hTreeItemPixmap QPushButton uise--RippleOverlay {
    qproperty-rippleInsetRight: 4;
}

uise--HTreeStandardListItem {padding:4px;}
uise--HTreeStandardListItem QLabel{padding:0;margin:0;}

uise--HTreeStandardListItem[htree_section_header="true"] #hTreeItemPixmap,
uise--HTreeStandardListItem[htree_section_header="true"] #hTreeItemPixmap QPushButton {
    max-width:0;
    min-width:0;
    padding:0;
    margin:0;
    border:none;
}

/* margin:0 above resets the margin-right:4px set for the generic case -- rippleInsetRight
 * resets to match. */
uise--HTreeStandardListItem[htree_section_header="true"] #hTreeItemPixmap QPushButton uise--RippleOverlay {
    qproperty-rippleInsetRight: 0;
}

uise--HTreeSplitterSection {padding:0;}
uise--HTreeSplitterLine {border:none;}

uise--HTreeList {padding:0;margin:0;}

uise--HTreeNode #nodeTopFrame,
uise--HTreeNode #nodeBottomFrame {
    padding: 10px;
}

uise--HTreeNode #nodeTopFrame uise--PushButton QPushButton,
uise--HTreeNode #nodeBottomFrame uise--PushButton QPushButton {
    icon-size: 20px;
}

uise--HTree QTabWidget::pane {padding:0;}

uise--HTreeTab #closeWarnFrame uise--PushButton {
margin: 10px;
}

/* margin:10px above grows each button's rect() 10px on every side -- rippleInset* on every
 * side compensate, keeping this in step with the margin above. */
uise--HTreeTab #closeWarnFrame uise--PushButton uise--RippleOverlay {
qproperty-rippleInsetLeft: 10;
qproperty-rippleInsetTop: 10;
qproperty-rippleInsetRight: 10;
qproperty-rippleInsetBottom: 10;
}

uise--HTreeTab #closeWarnFrame uise--PushButton QPushButton{
icon-size: 30px;
padding-top:2px;
padding-bottom:2px;
padding-left:0px;
padding-right:0px;
border-radius:16px;
}
