/* Chat object browsers: the bar of ChatObjectBrowserPanel, the empty text, the rows of the list
 * browsers (links, mentions; the file and voice rows are the chat's own file rows and keep their
 * chatmessagefiles.qss look) and the cells of the thumbnail grid. Colours are in light/ and dark/. */

/* --- panel bar --- */

uise--ChatObjectBrowserPanel #header {
padding:6px 8px;
}

/* PushButton's own styling contract (pushbutton.hpp): the INNER QPushButton owns padding/border/
   border-radius/background; the icon is sized with icon-size. */
uise--ChatObjectBrowserPanel #backButton QPushButton {
icon-size:20px;
padding:4px;
border-radius:6px;
border:1px solid transparent;
}

uise--ChatObjectBrowserPanel #title {
margin-left:4px;
}

uise--ChatObjectBrowserPanel #title QLabel {
font-weight:600;
}

/* --- search line --- */

/* The room around the line is the padding of its bar, NOT a margin of the line: LineEdit puts its search and cancel icons by the
   whole rect of the widget, margin included, so a margin on the line put them on the edges of the drawn box. */
uise--AbstractChatObjectBrowser #searchBar {
padding:8px 12px 4px 12px;
}

/* SearchLineEdit carries no padding of its own, so without this the box is as tall as the platform
   style makes a bare QLineEdit; same numbers as the reaction gallery's search box. */
uise--AbstractChatObjectBrowser #searchEdit {
padding-top:6px;
padding-bottom:6px;
}

/* --- month headings: above the first object of a month --- */

uise--ChatObjectListBrowser #monthHeader {
font-weight:600;
padding:14px 12px 6px 12px;
}

uise--ChatObjectGalleryBrowser #monthHeader {
font-weight:600;
padding:14px 4px 6px 4px;
}

/* --- empty text --- */

uise--AbstractChatObjectBrowser #emptyLabel,
uise--ChatObjectBrowserPanel #unknownLabel {
padding:24px;
}

/* the owner's line under the search line (ChatObjectsPage::notice): level with the text of the search line, a little room below */
uise--AbstractChatObjectBrowser #noticeLabel {
padding:0px 14px 8px 14px;
}

/* --- file and voice rows: a little room at the sides, the rest is chatmessagefiles.qss --- */

uise--ChatObjectListBrowser uise--ChatMessageFileItem {
padding:4px 8px;
}

/* --- link and mention rows --- */

/* a search result is a mention row with a snippet that wraps (ChatObjectSearchSnippet: at most three lines, set by code from
   the font) and has the found words highlighted (colours in light/ and dark/) */
uise--ChatObjectListBrowser #mentionRow,
uise--ChatObjectListBrowser #searchRow {
padding:4px 8px;
border-radius:8px;
}

/* A link row is a card (the text of the message, its links, the sender and the date) and is told from the next by a line,
   not by a hover tint: only its parts are clickable. */
uise--ChatObjectListBrowser #linkRow {
padding:8px 12px;
}

uise--ChatObjectListBrowser #linkRow #linksColumn {
margin:4px 0 0 0;
}

uise--ChatObjectListBrowser #linkRow #messageText {
margin:4px 0 0 0;
}

uise--ChatObjectListBrowser #linkRow #linkItem {
margin:2px 0;
}

uise--ChatObjectListBrowser #objectHeader #sender QLabel,
uise--ChatObjectListBrowser #objectHeader #time {
font-size:11px;
}

/* the title line of a row of an object (the sender and the date) is a little apart from what follows it */
uise--ChatObjectListBrowser #objectHeader {
margin-bottom:2px;
}

/* the title of a file or a voice row is the list's (ChatObjectRowFactory::buildTitle), above the row and as wide as the list: it
   starts where the icon of the row does (the 8px of the row's padding), and its date ends at the right edge of the list */
uise--ChatObjectListBrowser #listRow > #objectHeader {
margin:6px 8px 4px 8px;
}

/* the sender is the name of a person; our own messages ("You") are told by weight and, in light/ and dark/, by the colour */
uise--ChatObjectListBrowser #objectHeader #sender QLabel {
font-weight:600;
}

/* RoundedImage and AvatarWidget have no intrinsic size and collapse to nothing without one. */
uise--ChatObjectListBrowser #rowIcon,
uise--ChatObjectListBrowser #rowAvatar {
min-width:36px;
max-width:36px;
min-height:36px;
max-height:36px;
}

uise--ChatObjectListBrowser #textColumn {
margin-left:12px;
}

uise--ChatObjectListBrowser #title QLabel {
font-weight:600;
}

uise--ChatObjectListBrowser #url QLabel,
uise--ChatObjectListBrowser #meta QLabel {
font-size:11px;
}

/* --- thumbnail grid --- */

/* Gap and smallest cell, read by ChatObjectGalleryBrowser to compute the columns. */
uise--ChatObjectGalleryBrowser {
qproperty-minCellSize: 96;
qproperty-cellSpacing: 2;
}

/* Radius in step with ChatObjectGalleryCell::CornerRadius (the image is clipped by code); the
   cell's own background, in light/dark, is the placeholder shown until the thumbnail arrives. */
uise--ChatObjectGalleryBrowser #galleryCell {
border-radius:6px;
}
