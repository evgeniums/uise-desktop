uise--HTreeNodeTitleBar uise--ElidedLabel QLabel {color:#EEEEEE;}

uise--HTreeNodeTitleBar {
    border: 1px solid #999999;
    background-color: #888888;
    border-right:none;
}

uise--HTreeNodePlaceHolder {background-color: #C8C8C8;}
uise--HTreeNodePlaceHolder QPushButton {background-color: #C8C8C8;}

uise--HTreeStandardListItem QLabel {color:#000000;}
uise--HTreeStandardListItem[hover="true"] {background-color:#E8E8E8;}
uise--HTreeStandardListItem[selected="true"] {background-color:#CCCCCC;}

/* Update-ready list item — amber text to match the navbar button */
uise--HTreeStandardListItem[update_highlight="true"] QLabel {color:#B06000; font-weight:bold;}
uise--HTreeStandardListItem[update_highlight="true"][hover="true"] {background-color:#FFF0CC;}
uise--HTreeStandardListItem[update_highlight="true"][selected="true"] {background-color:#FFE0A0;}

uise--HTreeStandardListItem[htree_section_header="true"][hover="true"] {background-color:transparent;}
uise--HTreeStandardListItem[htree_section_header="true"][selected="true"] {background-color:transparent;}
uise--HTreeStandardListItem[htree_section_header="true"] QLabel {color:#999999;}

uise--HTreeSplitterLine {background-color:#DDDDDD;}

uise--HTreeNode #nodeTopFrame {
    background-color: #DDDDDD;
}

uise--HTree,
uise--HTreeNode {
background-color: #F0F0F0;
border:none;
}

uise--HTreeTab, uise--HTreeSideBar {
border:none;
}

uise--HTreeTab #closeWarnFrame {
border: 2px solid #FB9B8F;
background-color: transparent;
}

uise--HTreeTab #closeWarnFrame uise--PushButton QPushButton{
background-color:#FB9B8F;
}

uise--HTreeTab {
margin-right: -2px;
}

uise--HTreeTab #hTreeTabs {
border:none;
}

/* Mirrors reset.qss's QTabBar::tab/:disabled/:selected/:selected:disabled/:!selected rules
   value-for-value -- same colors, same border/radius -- so a custom-tab-bar HTree looks like
   any other tab widget in the app. #hTreeTabBar::tab is an ID+subcontrol selector, so it
   outranks the generic QTabBar::tab rules on specificity regardless of stylesheet load order
   (see htreetabbar.hpp's own doc comment on HTreeTabBar). `padding`/`color` are deliberately
   NOT mirrored here -- the item widget fills the whole tab rect itself (see
   HTree::htreeTabBar()->setItemMargins(), set from whitemdesktop to the same 6px/10px reset.qss
   uses) and paints its own text (see uise--HTreeTabBarItem below), so this rule only needs to
   supply the shape's background/border. */
#hTreeTabBar::tab {
background-color: #F0F0F0;
border: 1px solid #CCCCCC;
border-bottom: none;
}

#hTreeTabBar::tab:disabled {
background-color: #BBBBBB;
}

#hTreeTabBar::tab:selected {
background-color: #1e6091;
border-top-left-radius: 4px;
border-top-right-radius: 4px;
}

#hTreeTabBar::tab:selected:disabled {
background-color: #C0C0C0;
border-top-left-radius: 4px;
border-top-right-radius: 4px;
}

#hTreeTabBar::tab:!selected {
background-color: #F0F0F0;
}

uise--HTreeTabBarItem {
background-color: transparent;
}

/* Text color mirrors QTabBar::tab's own color/:selected color (reset.qss) -- current here is
   this item's own "current" property (see HTreeTabBarItem::setCurrent()), not a native QSS
   pseudo-state, since the item intercepts mouse/paint and QTabBar never sees this tab as
   selected in the native sense. */
uise--HTreeTabBarItem #text {
color: #333333;
}

uise--HTreeTabBarItem[current="true"] #text {
color: #FFFFFF;
}

uise--AlignedStretchingWidget,
uise--HTreeSplitterInternal,
uise--HTreeSplitter {
border:none;
}
