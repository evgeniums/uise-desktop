/* Text inside a blockquote, kept in step with the `blockquote` colour in
   light/messagetext.css so a quote reads the same in the composer and in the bubble it becomes.
   Applied through a QSyntaxHighlighter, so it never reaches the document and never leaks into the
   sent message -- see EnhancedTextEdit::setBlockquoteColor(). Being re-applied on every repolish
   is what makes a quote recolour on a theme switch instead of freezing at the colour it was
   typed in. */
uise--MessageEditor uise--EnhancedTextEdit {
qproperty-codeBlockColor: #444444;
qproperty-blockquoteColor: #666666;
/* Kept in step with light/chat.qss's ChatMessageTextBrowser::linkColor/linkUnderline, so a link
   reads the same in the composer and in the bubble it becomes. Without this an inserted link is
   invisible AS a link -- Qt's layout draws an anchor exactly like ordinary text, and the blue an
   imported link used to show was baked into the document by Qt's own markdown importer, frozen at
   the theme it arrived in. See EnhancedTextEdit::setLinkColor(). */
qproperty-linkColor: #1A6FD4;
qproperty-linkUnderline: false;
/* Task-message-formatting-plan.md, Stage 6: a mention reads as distinct from an ordinary link --
   a violet against the link blue above. Kept in step with light/chat.qss's
   ChatMessageTextBrowser::mentionColor so a mention looks the same in the composer and in the
   bubble it becomes. See EnhancedTextEdit::setMentionColor(). */
qproperty-mentionColor: #7A3FBF;
/* Squiggle under a word no loaded dictionary accepts (task-spellcheck.md). Apple's own light-mode
   systemRed, for a colour that reads as an obvious "error" the moment it appears rather than a
   muted accent -- unlike every other colour on this page, this one exists to be noticed. A theme
   colour, so being re-applied on every repolish is the point -- see
   EnhancedTextEdit::setSpellCheckUnderlineColor(). Drawn by EnhancedTextEdit::paintEvent() now,
   not by a QTextCharFormat underline style -- see EnhancedTextEdit::SpellCheckUnderlineProperty
   for why. */
qproperty-spellCheckUnderlineColor: #FF3B30;
/* Pen width of that squiggle, in device-independent pixels. Set explicitly rather than left at
   the auto default so the value is visible and tunable here: painted by hand now instead of via
   QTextCharFormat::SpellCheckUnderline, which drew at the font's own lineThickness() -- about one
   pixel, faint enough on macOS's dotted rendering to read as a rendering artefact rather than a
   mark. 0 restores "auto" (see EnhancedTextEdit::setSpellCheckUnderlineWidth()). */
qproperty-spellCheckUnderlineWidth: 2;
}

uise--MessageEditorToolbar {
border-bottom: 1px solid #E4E4E4;
}

uise--MessageEditorToolbar #separator {
background-color: #D0D0D0;
}

uise--MessageEditorToolbar uise--IconTextButton:hover,
uise--MessageEditor #leadingWidgets uise--IconTextButton:hover,
uise--MessageEditor #trailingWidgets uise--IconTextButton:hover {
background-color: #EAEAEA;
}

uise--MessageEditorToolbar uise--IconTextButton[checked="true"],
uise--MessageEditor #leadingWidgets uise--IconTextButton[checked="true"],
uise--MessageEditor #trailingWidgets uise--IconTextButton[checked="true"] {
background-color: #DCE8F5;
}
