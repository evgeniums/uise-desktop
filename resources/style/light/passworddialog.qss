uise--PasswordPanel QLabel#error,
uise--NewPasswordPanel QLabel#error,
#NewPasswordWizard QLabel#error,
uise--PasswordDialog uise--PasswordPanel QLabel#error{
color: #ff6677;
}

/* abstractdialog.qss greys out every label inside a dialog with
 * `uise--AbstractDialog #dialogFrame QLabel {color: #444444;}` -- 1 id + 2 type names, which
 * exactly TIES the specificity of the generic error selectors above. Qt breaks a specificity tie
 * by rule order, i.e. by the order the qss files happened to be concatenated in, and
 * Style::reloadStyleSheet() appends the per-theme files by iterating a QSet (hash order), so a
 * panel error label inside a dialog would come out red or grey unpredictably. Naming the dialog
 * ancestor lifts these to a strictly higher specificity so the outcome no longer depends on load
 * order -- the same trick the `uise--PasswordDialog uise--PasswordPanel` selector above uses.
 * Keep in step with the generic rule above. */
uise--AbstractDialog uise--PasswordPanel QLabel#error,
uise--AbstractDialog uise--NewPasswordPanel QLabel#error{
color: #ff6677;
}

uise--NewPasswordPanel #buttonsFrame uise--IconTextButton #text {
color: #444444;
}

uise--NewPasswordPanel #buttonsFrame uise--IconTextButton #text[hovered="true"] {
color:#000000;
}

#NewPasswordWizard uise--PasswordInput
{
background-color: #F0F0F0;
border-radius: 12px;
padding: 16px 20px 24px 20px;
}

#NewPasswordWizard uise--PasswordPanel,
#NewPasswordWizard QTextBrowser
{
background-color: #F8F8F8;
}
