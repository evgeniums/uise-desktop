/* Chat viewport background. Nothing else keys on this colour/image any more -- the bubble tail
 * used to be carved out of an opaque #mask child painted in this exact colour, so this rule had
 * to stay in lockstep with it. ChatMessageAvatar now paints the tail's own shape directly (see
 * chat.qss), so this rule is free to be a texture, gradient or per-chat background image without
 * the tail needing to know about it -- background-color is the fallback while the image loads
 * and shows through its transparent pixels, if any. No background-position: it defaults to the
 * widget's own top-left, which is what makes the tile line up seamlessly across the whole
 * viewport instead of each widget centring its own copy of the tile. */
uise--AbstractChatMessagesView
{
background-color: /*#8BBB92*/ /*#78A4CB*/ /*#8BAABB*/ /*#85b4cc*/ #A5C6D7; /* chat background */
background-image: url(":/uise/desktop/style/light/noisy-texture-100x100-o3-d13-c-A5C6D7-t1.png");
background-repeat: repeat-xy;
}

uise--AbstractChatMessageContent {
background-color: /*#F7F4E1*/ /*#F4EFE6*/ /*#FAF6F0*/ /*#DFF1F1*/ /*#FFFFFF*/ #F9FAFB; /* received message */
}

uise--AbstractChatMessageContent[selected="true"] {
background-color: #AEE2FF; /* selected received message */
}

uise--AbstractChatMessageContent[sent="true"] {
background-color: /*#E2ECD5*/ /*#E2E8EC*/ /*#E5F2FD*/ #DEEFFB; /* sent message */
}
uise--AbstractChatMessage uise--ChatMessageAvatar[sent="true"] {
qproperty-tailColor: #DEEFFB; /* sent message */
}

uise--AbstractChatMessageContent[selected="true"][sent="true"] {
background-color: #AEE2FF; /* selected sent message */
}

/* Tail colours, paired one-for-one with the bubble colours above -- the tail is the bubble's own
 * corner continued outwards, so these must never drift apart. qproperty-tailColor rather than
 * background-color because ChatMessageAvatar paints the tail itself (see chat.qss's
 * qproperty-tailWidth/qproperty-tailHeight). Deliberately NOT keyed on [last="true"]: Qt does
 * not restore a qproperty-* whose rule stops matching, so keying on last would leave a stale
 * colour on a row recycled from last to non-last -- keying on sent/selected alone covers all 4
 * reachable combinations unconditionally, and ChatMessageAvatar::paintEvent() is what actually
 * suppresses the tail when the row isn't last. */
uise--AbstractChatMessage uise--ChatMessageAvatar[sent="false"] {
qproperty-tailColor: #FFFFFF /*#FDFCF8*/; /* received message */
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="false"] {
qproperty-tailColor: #AEE2FF; /* selected received message */
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="true"] {
qproperty-tailColor: #AEE2FF; /* selected sent message */
}

uise--ChatMessageText uise--ChatMessageTextBrowser {
background-color: transparent;
border:none;
selection-background-color: #074eb8;
qproperty-linkColor: #1A6FD4; /* task-urls-and characters-in-messages.md, Stage 1 */
qproperty-linkUnderline: false;
qproperty-mentionColor: #7A3FBF; /* task-message-formatting-plan.md, Stage 6 -- kept in step
    with light/messageeditor.qss's EnhancedTextEdit::mentionColor, so a mention looks the same in
    the composer and in the bubble it becomes */
}

/* Jump-to-message highlight -- same tint as a reply block's own background (see
 * uise--AbstractChatMessageReply in replypreview.qss/light/replypreview.qss: a plain black wash
 * at 5% opacity), reused here rather than a distinct hue so both "something else refers to this
 * message" cues (a reply quote, a landed-on jump) read as the same visual language.
 * highlightColor is opaque; highlightOpacity is the peak fraction the fade animates against 0,
 * same rippleColor/rippleOpacity convention as RippleOverlay. */
uise--AbstractChatMessage {
qproperty-highlightColor: #000000;
qproperty-highlightOpacity: 0.05;
}

uise--ChatMessageBottom QLabel {
color: #77778F;
}
/*
separate style for bottom labels in sent bubble not used any more
*/
/*
uise--ChatMessageBottom QLabel[sent="true"]{
color: #3F6FA0;
}
*/

uise--ChatMessageBottom QLabel[selected="true"],
uise--ChatMessageBottom QLabel[selected="true"][sent="true"]{
color: #1e6091;
}

uise--ChatSeparatorSection uise--AvatarButton,
uise--ChatSeparatorSection[separator_type="unread"]{
background-color: rgba(255, 255, 255, 0.45);
}

uise--ChatSeparatorSection[separator_type="unread"] uise--AvatarButton {
background-color:transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff {
background-color: #E0E0E0;
border: 2px solid transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
background-color: #AEE2FF; /* selected message */
border: 2px solid transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff[hovered="true"] {
background-color: #E0E0E0;
border: 2px solid #E0E0E0;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn[hovered="true"] {
background-color: #AEE2FF; /* selected message */
border: 2px solid #AEE2FF; /* selected message */
}

uise--MessageSelectionPanelUi #drawer {
background-color: #DDDDDD; /* node top frame */
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
background-color: #218DAE; /* selection push button */
color: #EEEEEE;
border: 1px solid #218DAE;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton:hover {
background-color: #0099b8;
color: #FFFFFF;
border: 1px solid #218DAE;
}

/* #cancel overrides the fill back to transparent (borderless text button) -- border must be
 * restated here too, otherwise the more general rule above's new border leaks onto it. */
uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
background-color: transparent;
border: none;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
color: #218DAE;
border: none;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton:hover {
color: #0099b8;
border: none;
}

/* task-message-formatting-plan.md, Stage 4: the expand affordance floated over a table
   (structure in ../chat.qss). Deliberately low-contrast at rest so it does not compete with the
   message text it sits on top of, lifting to full contrast on hover. It keeps this treatment
   rather than the dialog-button one below -- it is an overlay on content, not a dialog control. */
/* Both this and the code-block strip below take light/abstractdialog.qss's own button palette --
   the #218DAE accent fill with #0099b8 on hover -- so floating chrome over message content reads
   as the same kind of control everywhere in the app rather than inventing a third look.

   The icons are light to match (chat.json's light-mode currentColor is #EEEEEE/#FFFFFF for this
   context, mirroring the dialog button's own text colours) -- they used to be dark for contrast
   against a white backing, and the two have to move together.

   OPAQUE, unlike ChatMessageImageItem's #menuButton which this is otherwise modelled on. That one
   floats over a photo, where letting the image show through is the point. This one floats over a
   TABLE: text under the button is unreadable either way, so translucency buys nothing, and all it
   actually does is let cell borders and glyphs bleed through and make the button itself look
   noisy. The button's job here is to mask what is behind it cleanly. */
uise--ChatMessageTextBrowser #tableExpandButton {
background-color: #218DAE;
}

uise--ChatMessageTextBrowser #tableExpandButton:hover {
background-color: #0099b8;
}

/* The expanded viewer's own button row follows light/abstractdialog.qss's button palette, with
   the same primary/secondary split: Copy table is the affirmative action and gets the accent
   fill, while Full screen and Close take the borderless-accent-text treatment that file gives
   its dismissive buttons (#close/#cancel/#no/...). Sizing matches that file's own final
   override (min-width 80px, padding 3px 12px). */
/* The code-block viewer (ChatMessageTextBrowser::openCodeBlockViewer()) is the same shell with the
   same three roles, so it is styled by the same rules rather than a parallel copy -- the two
   viewers differing in button treatment would be a bug, not a distinction. */
#tableViewerFrame #tableViewerCopyButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCopyButton QPushButton {
background-color: #218DAE;
color: #EEEEEE;
border: 1px solid #218DAE;
}
#tableViewerFrame #tableViewerCopyButton QPushButton:hover,
#codeBlockViewerFrame #codeBlockViewerCopyButton QPushButton:hover {
background-color: #0099b8;
color: #FFFFFF;
border: 1px solid #0099b8;
}

#tableViewerFrame #tableViewerFullScreenButton QPushButton,
#tableViewerFrame #tableViewerCloseButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerFullScreenButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCloseButton QPushButton {
color: #555555;
border: 1px solid #999999;
background-color: transparent;
}
#tableViewerFrame #tableViewerFullScreenButton QPushButton:hover,
#tableViewerFrame #tableViewerCloseButton QPushButton:hover,
#codeBlockViewerFrame #codeBlockViewerFullScreenButton QPushButton:hover,
#codeBlockViewerFrame #codeBlockViewerCloseButton QPushButton:hover {
color: #444444;
border: 1px solid #444444;
}

#tableViewerFrame #tableViewerFullScreenButton QPushButton,
#tableViewerFrame #tableViewerCopyButton QPushButton,
#tableViewerFrame #tableViewerCloseButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerFullScreenButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCopyButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCloseButton QPushButton {
min-width: 80px;
padding: 3px 12px;
}

/* FloatingDialogFrame is a translucent top-level window -- content that does not paint its own
   background shows straight through it (see docs/styling.md section 7). Without this the button
   row around the Copy table button is transparent. */
#tableViewerFrame,
#codeBlockViewerFrame {
background-color: #FFFFFF;
}


/* The code-block overlay strip. Same job as #tableExpandButton's fill above: mask the code behind
   it cleanly so the label and icon stay legible, without becoming a second visual element in its
   own right. The language label is deliberately quieter than the code it labels. */
uise--ChatMessageTextBrowser #codeBlockOverlay {
background-color: #218DAE;
}

/* #EEEEEE is the dialog button's own text colour on this fill, not a fresh choice. */
uise--ChatMessageTextBrowser #codeBlockLanguage {
color: #EEEEEE;
}

/* The strip's buttons stay transparent so it reads as one control, and take the dialog button's
   hover fill as their own feedback. */
uise--ChatMessageTextBrowser #codeBlockCopyButton:hover,
uise--ChatMessageTextBrowser #codeBlockExpandButton:hover {
background-color: #0099b8;
}
