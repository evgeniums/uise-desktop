/* Chat viewport background. Nothing else keys on this colour/image any more -- the bubble tail
 * used to be carved out of an opaque #mask child painted in this exact colour, so this rule had
 * to stay in lockstep with it. ChatMessageAvatar now paints the tail's own shape directly (see
 * chat.qss), so this rule is free to be a texture, gradient or per-chat background image without
 * the tail needing to know about it -- background-color is the fallback while the image loads
 * and shows through its transparent pixels, if any. No background-position: it defaults to the
 * widget's own top-left, which is what makes the tile line up seamlessly across the whole
 * viewport instead of each widget centring its own copy of the tile. */
uise--AbstractChatMessagesView
{
background-color: /*#8BBB92*/ /*#78A4CB*/ #8BAABB; /* chat background */
background-image: url(":/uise/desktop/style/light/noisy-texture-100x100-o6-d10-c-8BAABB-t0.png");
/* "repeat-xy", NOT CSS's "repeat" -- Qt QSS only knows repeat-x/repeat-y/repeat-xy/no-repeat.
 * An unrecognised value parses to Repeat_Unknown, which makes QRenderRule fall through to
 * drawPixmap() instead of drawTiledPixmap(), i.e. the image is drawn exactly ONCE at the
 * widget's top-left at its native size (512pt here) and the rest of the view stays flat
 * background-color. Omitting the property entirely would also tile (Repeat_XY is the default);
 * it is spelled out here so the intent is explicit. */
background-repeat: repeat-xy;
}

uise--AbstractChatMessageContent {
background-color: /*#F7F4E1*/ /*#F4EFE6*/ /*#FAF6F0*/ /*#DFF1F1*/ /*#FFFFFF*/ #F9FAFB; /* received message */
}

uise--AbstractChatMessageContent[selected="true"] {
background-color: #AEE2FF; /* selected received message */
}

uise--AbstractChatMessageContent[sent="true"] {
background-color: /*#E2ECD5*/ /*#E2E8EC*/ /*#E5F2FD*/ #DEEFFB; /* sent message */
}
uise--AbstractChatMessage uise--ChatMessageAvatar[sent="true"] {
qproperty-tailColor: #DEEFFB; /* sent message */
}


uise--AbstractChatMessageContent[selected="true"][sent="true"] {
background-color: #AEE2FF; /* selected sent message */
}

/* Tail colours, paired one-for-one with the bubble colours above -- the tail is the bubble's own
 * corner continued outwards, so these must never drift apart. qproperty-tailColor rather than
 * background-color because ChatMessageAvatar paints the tail itself (see chat.qss's
 * qproperty-tailWidth/qproperty-tailHeight). Deliberately NOT keyed on [last="true"]: Qt does
 * not restore a qproperty-* whose rule stops matching, so keying on last would leave a stale
 * colour on a row recycled from last to non-last -- keying on sent/selected alone covers all 4
 * reachable combinations unconditionally, and ChatMessageAvatar::paintEvent() is what actually
 * suppresses the tail when the row isn't last. */
uise--AbstractChatMessage uise--ChatMessageAvatar[sent="false"] {
qproperty-tailColor: #FFFFFF /*#FDFCF8*/; /* received message */
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="false"] {
qproperty-tailColor: #AEE2FF; /* selected received message */
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="true"] {
qproperty-tailColor: #AEE2FF; /* selected sent message */
}

uise--ChatMessageText uise--ChatMessageTextBrowser {
background-color: transparent;
border:none;
selection-background-color: #AFC8E8; /* selected message */
qproperty-linkColor: #1A6FD4; /* task-urls-and characters-in-messages.md, Stage 1 */
qproperty-linkUnderline: false;
}

/* Jump-to-message highlight -- same tint as a reply block's own background (see
 * uise--AbstractChatMessageReply in replypreview.qss/light/replypreview.qss: a plain black wash
 * at 5% opacity), reused here rather than a distinct hue so both "something else refers to this
 * message" cues (a reply quote, a landed-on jump) read as the same visual language.
 * highlightColor is opaque; highlightOpacity is the peak fraction the fade animates against 0,
 * same rippleColor/rippleOpacity convention as RippleOverlay. */
uise--AbstractChatMessage {
qproperty-highlightColor: #000000;
qproperty-highlightOpacity: 0.05;
}

uise--ChatMessageBottom QLabel {
color: #77778F;
}
/*
separate style for bottom labels in sent bubble not used any more
*/
/*
uise--ChatMessageBottom QLabel[sent="true"]{
color: #3F6FA0;
}
*/

uise--ChatMessageBottom QLabel[selected="true"],
uise--ChatMessageBottom QLabel[selected="true"][sent="true"]{
color: #1e6091;
}

uise--ChatSeparatorSection uise--AvatarButton,
uise--ChatSeparatorSection[separator_type="unread"]{
background-color: rgba(255, 255, 255, 0.45);
}

uise--ChatSeparatorSection[separator_type="unread"] uise--AvatarButton {
background-color:transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff {
background-color: #E0E0E0;
border: 2px solid transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
background-color: #AEE2FF; /* selected message */
border: 2px solid transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff[hovered="true"] {
background-color: #E0E0E0;
border: 2px solid #E0E0E0;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn[hovered="true"] {
background-color: #AEE2FF; /* selected message */
border: 2px solid #AEE2FF; /* selected message */
}

uise--MessageSelectionPanelUi #drawer {
background-color: #DDDDDD; /* node top frame */
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
background-color: #218DAE; /* selection push button */
color: #EEEEEE;
border: 1px solid #218DAE;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton:hover {
background-color: #0099b8;
color: #FFFFFF;
border: 1px solid #218DAE;
}

/* #cancel overrides the fill back to transparent (borderless text button) -- border must be
 * restated here too, otherwise the more general rule above's new border leaks onto it. */
uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
background-color: transparent;
border: none;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
color: #218DAE;
border: none;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton:hover {
color: #0099b8;
border: none;
}
