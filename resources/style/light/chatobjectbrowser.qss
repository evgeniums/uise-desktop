uise--ChatObjectBrowserPanel #header {
border-bottom:1px solid #EEEEEE;
}

uise--ChatObjectBrowserPanel #backButton[hovered="true"] QPushButton {
background-color: rgba(0,0,0,10);
}

uise--AbstractChatObjectBrowser #emptyLabel,
uise--ChatObjectBrowserPanel #unknownLabel {
color: #888888;
}

/* same tint as the chat file row's hover */
uise--ChatObjectListBrowser #mentionRow:hover {
background-color: rgba(0,0,0,6);
}

uise--ChatObjectListBrowser #linkRow {
border-bottom:1px solid #DCDCDC;
}

/* the links are links: the colour of the share-me nodes' username, underlined under the pointer */
uise--ChatObjectListBrowser #linkItem QLabel {
color: #0099b8;
}

uise--ChatObjectListBrowser #linkItem QLabel:hover {
color: #00b4d8;
text-decoration: underline;
}

uise--ChatObjectListBrowser #objectHeader #sender QLabel,
uise--ChatObjectListBrowser #objectHeader #time {
color: #666666;
}

/* the hue of the author in the chat list (chatlist.qss #lastAuthor) */
uise--ChatObjectListBrowser #objectHeader #sender[self="true"] QLabel {
color: #2A6E8C;
}

uise--ChatObjectListBrowser #url QLabel,
uise--ChatObjectListBrowser #meta QLabel {
color: #666666;
}

/* placeholder: the subtle tint the resting reaction chip uses, not a new hue */
uise--ChatObjectGalleryBrowser #galleryCell {
background-color: rgba(0,0,0,10);
}

uise--ChatObjectListBrowser #monthHeader,
uise--ChatObjectGalleryBrowser #monthHeader {
color: #666666;
}
