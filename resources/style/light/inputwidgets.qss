uise--ValidatedInput QLineEdit[state="intermediate"]{
color: #777777;
}

uise--ValidatedInput QLineEdit[state="invalid"]{
color: #ff6677;
}

/* Apply: filled accent (affirmative action), same primary treatment used for bottom
 * dialog/panel buttons elsewhere (see abstractdialog.qss) -- hover darkens/brightens the
 * background too, not just the text, kept in sync with that file.
 *
 * The :disabled rule carries more weight here than usual: ValidatedInput starts its Apply
 * button disabled and only enables it once the input validates as Acceptable (see
 * validatedinput.cpp), so this is the state the button is in most of the time. */
uise--ValidatedInput uise--PushButton QPushButton
{background-color: #218DAE; color: #EEEEEE; border: 1px solid #218DAE;}

uise--ValidatedInput uise--PushButton QPushButton:disabled,
uise--ValidatedInput uise--PushButton QPushButton:disabled:hover
{background-color: #DDDDDD; color: #999999; border: 1px solid #DDDDDD;}

uise--ValidatedInput uise--PushButton QPushButton:hover
{color: #FFFFFF; background-color: #0099b8; border: 1px solid #0099b8;}

uise--ValidatedInput QLabel#error {
color: #ff6677;
}
