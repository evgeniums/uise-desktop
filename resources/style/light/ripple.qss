/*
 * RippleOverlay – light theme colour.
 *
 * qproperty-rippleColor   – dark ink, low alpha reads as a soft grey wash on light backgrounds
 * qproperty-rippleOpacity – peak alpha, as a 0-1 fraction of rippleColor's own alpha
 */

uise--RippleOverlay {
    qproperty-rippleColor:   #000000;
    qproperty-rippleOpacity: 0.10;
}

/* The global default above is tuned for large, already-busy button chrome (icon + text +
 * hover background) -- PushButton is comparatively plain (native QPushButton/QToolButton
 * chrome, no competing hover fill of its own in most consuming stylesheets), so it reads
 * better boosted well above that baseline. */
 /*
uise--PushButton uise--RippleOverlay {
    qproperty-rippleOpacity: 0.15;
}
*/

/* DropdownMenu rows are IconTextButtons (see dropdownmenu.cpp), so they inherit ripple
 * automatically -- but at the 0.02 global default they are effectively invisible, same root
 * cause as PushButton above. Kept below PushButton's boost since IconTextButton chrome is
 * busier (icon + text + hover background all competing for attention already). */
 /*
uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleOpacity: 0.08;
}
*/

/* Same reasoning as PushButton/IconTextButton above: the 0.02 global default is invisible
 * against the plain indicator chrome (see checkbox.qss). */
 /*
uise--AbstractCheckBox uise--RippleOverlay {
    qproperty-rippleOpacity: 0.10;
}
*/
