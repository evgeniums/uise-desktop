uise--AbstractEditablePanel {
border: 1px solid #E4E4E4;
background-color: #F0F0F0;
}

uise--EditablePanel #contentFrame{
}

uise--EditablePanel QLabel,
uise--EditablePanel uise--EditableLabel QLabel#comment {
color: #555555;
}

uise--EditablePanel QLabel:disabled,
uise--EditablePanel uise--EditableLabel QLabel#comment:disabled {
color: #999999;
}

uise--EditablePanel uise--EditableLabel QLabel#label {
background-color: #DDDDDD;
color: #000000;
}

uise--EditablePanel uise--EditableLabel QLabel#label:disabled {
color: #999999;
}

uise--EditablePanel uise--PushButton QPushButton
{color: #555555;background-color: transparent;border: 1px solid #888888;}

/* Bottom Apply/Cancel row: filled accent for Apply, borderless accent text for Cancel --
 * same primary/secondary split as MessageSelectionPanelUi's drawer buttons (see chat.qss).
 *
 * Vertical padding bumped from the structural 4px to 8px (light theme only, horizontal
 * padding unchanged at 12px) -- these buttons now carry a solid fill/accent text, and read
 * better with more room than the old plain outlined look needed. */
uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsApply QPushButton
{background-color: #218DAE; color: #EEEEEE; border: none; padding: 8px 12px;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsApply QPushButton:hover
{color: #FFFFFF;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsApply QPushButton:disabled
{background-color: #DDDDDD; color: #999999; border: none;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsCancel QPushButton
{background-color: transparent; color: #218DAE; border: none; padding: 8px 12px;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsCancel QPushButton:hover
{color: #0099b8;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton#bottomButtonsCancel QPushButton:disabled
{background-color: transparent; color: #999999; border: none;}

uise--EditablePanel uise--PushButton QPushButton:hover
{color: #000000;border: 1px solid #000000;}

uise--EditablePanel #topButtonsFrame uise--PushButton QPushButton {
color: #218DAE;
}

uise--EditablePanel #topButtonsFrame uise--PushButton QPushButton:hover {
color: #0099b8;
}

uise--EditablePanel #topButtonsFrame uise--PushButton QPushButton {
border:none;
}

uise--EditablePanel #topButtonsFrame uise--PushButton QPushButton:hover {
border:none;
}

uise--EditablePanel #statusFrame #statusText[status="error"]{
color: #ff6677;
}

uise--EditablePanel #topButtonsFrame,
uise--EditablePanel #bottomButtonsFrame,
uise--EditablePanel #titleFrame {
background-color:transparent;
}
