/*
 * ChatVoiceFileItem -- light theme colours.
 *
 * #playOverlay deliberately keeps the ORIGINAL waveform pale blue (#b3d1f0), not waveformbar.qss's
 * own barColor: that one was darkened for contrast against the played bars (task-voice-messages-
 * plan.md S4f item 2), which a solid tile does not need. Do not resync them. The hover border and
 * #listenedDot stay the deep "played"/typing-indicator blue.
 */

uise--ChatVoiceFileItem #playOverlay {
    background-color: #b3d1f0;
}

uise--ChatVoiceFileItem #playOverlay:hover {
    border-color: #1a6bc4;
}

uise--ChatVoiceFileItem #listenedDot {
    background-color: #1a6bc4;
}

/* the playing clock -- same grey as #infoLabel, which it stands in for */
uise--ChatVoiceFileItem #clockFrame QLabel {
    color: #666666;
}
