uise--PushButton QPushButton {
    padding: 2px;
}

/* Native QCheckBox/QRadioButton rules -- still needed for Qt's own dialogs (QFileDialog, ...)
 * and for third-party widgets, so kept in place. uise's own checkbox/radio widgets are
 * CheckBox/RadioBox (see checkbox.qss) -- these numbers are intentionally duplicated there so
 * the two look identical, not accidentally out of sync. */
QCheckBox, QRadioButton {
padding: 2px 2px;
border-radius: 2px;
border: 2px solid transparent;
spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 10px;
}

uise--IconTextButton QLabel {
margin-right: 0;
margin-left: 0;
}

uise--IconTextButton QLabel[position="before"] {
margin-right: 2px;
margin-left: 0;
}

uise--IconTextButton QLabel[position="after"] {
margin-right: 0;
margin-left: 2px;
}

QTabBar {
qproperty-drawBase: false;
background: transparent;
border:none;
}
