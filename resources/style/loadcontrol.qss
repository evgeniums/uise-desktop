uise--LoadControl,
uise--CircleBusy,
uise--LoadControlMenu {
min-width:56px;min-height:56px;max-width:56px;max-height:56px;
}

uise--LoadControlMenu {
padding:0;
margin:0;
}

uise--LoadControl #sample,
uise--CircleBusy #sample {
border: 3px solid transparent;
}

/*
 * CircleBusy configurable parameters.
 *
 * qproperty-circlePercent  – arc length as % of full circle (0-100)
 * qproperty-easingCurveType – QEasingCurve::Type as int
 *                             (17=InSine 18=OutSine 19=InOutSine 20=OutInSine)
 */
uise--CircleBusy {
    qproperty-circlePercent:   15;
    qproperty-easingCurveType: 19;
}

/*
 * LoadControl animated-mode parameters, used when progressMode() is Indeterminate or
 * AnimatedProgress (ignored in the default Static mode).
 *
 * qproperty-circlePercent     – arc length as % of full circle in Indeterminate mode
 * qproperty-animationDuration – ms per full revolution of the circulating arc
 * qproperty-easingCurveType   – QEasingCurve::Type as int (0=Linear, 19=InOutSine)
 */
uise--LoadControl {
    qproperty-circlePercent:     15;
    qproperty-animationDuration: 1000;
    qproperty-easingCurveType:   19;
}
