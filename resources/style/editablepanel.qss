uise--EditablePanel {
  margin: 6px 12px 2px 12px;
  border-radius: 8px;
  padding: 6px;

/* Title and bottom buttons row alignment (applied at polish time; uncomment to override
 * the C++ defaults from setTitleAlignment() / setBottomButtonsAlignment()).
 *
 * Space-separated tokens. ALWAYS QUOTE the value -- Qt's CSS tokenizer splits an unquoted
 * multi-token value and only the first token survives.
 *   "left" | "right" | "hcenter" | "justify"
 *   "stretch" -- the title / bottom buttons row spans the full panel width
 * "" or "default" restores the Qt::AlignHCenter default.
 *
 * qproperty-titleAlignment:         "left";
 * qproperty-bottomButtonsAlignment: "right";
 */
}

uise--EditablePanel uise--EditableLabel QLabel {
  padding: 4px;
  border-radius: 4px;
}

uise--EditablePanel uise--EditableLabel QLineEdit {
padding: 2px;
}

uise--EditablePanel uise--EditableLabel QTextEdit {
max-height: 50px;
}

uise--FrameWithModalStatus uise--EditableLabel uise--PushButton QPushButton {
border:none;
padding: 2px;
margin:0;
}

uise--FrameWithModalStatus uise--EditableLabel uise--PushButton {
padding:0;
margin:0;
}

uise--FrameWithModalStatus uise--EditableLabel uise--PushButton QPushButton:hover {
border:none;
}

uise--EditablePanel #panelTitle {
font-size:16px;
}

uise--EditablePanel uise--PushButton QPushButton
{border-radius: 6px; padding: 4px 12px;}

uise--EditablePanel #bottomButtonsFrame uise--PushButton {
margin: 8px 4px;
}

/* margin: 8px 4px above grows each button's rect() 8px top/bottom and 4px left/right --
 * rippleInset* on every side compensate, keeping this in step with the margin above. */
uise--EditablePanel #bottomButtonsFrame uise--PushButton uise--RippleOverlay {
qproperty-rippleInsetLeft: 4;
qproperty-rippleInsetTop: 8;
qproperty-rippleInsetRight: 4;
qproperty-rippleInsetBottom: 8;
}

uise--EditablePanel #topButtonsFrame #topButtonEdit QPushButton:disabled {
color:transparent;
}

uise--EditablePanels {
padding-bottom: 6px;
}

uise--EditablePanel #statusFrame {
margin-left: 16px;
margin-right: 16px;
margin-top: 4px;
margin-bottom: 4px;
}

uise--EditablePanel #panelLabel {
margin-top: 1px;
}
