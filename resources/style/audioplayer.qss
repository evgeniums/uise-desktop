/*
 * AudioPlayerWidget -- layout and metrics (theme-neutral).
 * Colours live in light/audioplayer.qss and dark/audioplayer.qss, icon colours in the
 * light|dark audioplayer.json files.
 */

uise--AudioPlayerWidget {
    padding: 6px 8px;
}

uise--AudioPlayerWidget #bottomRow {
    margin-top: 4px;
}

uise--AudioPlayerWidget uise--IconTextButton uise--RoundedImage {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

uise--AudioPlayerWidget #topRow uise--IconTextButton {
    margin-left: 4px;
}

uise--AudioPlayerWidget #bottomRow uise--IconTextButton {
    margin-right: 4px;
}

/*
 * A QSS margin is part of the widget's own rect in Qt, and the ripple overlay covers that rect, so the halo would
 * be centred on the button and its margin band and not on the icon (see the rippleInset note in ripple.qss).
 * The insets are the margins above: keep them in step. The speed button is handled in code, by
 * AudioPlayerWidget::centerRippleOnText(), which sets both insets itself.
 */
uise--AudioPlayerWidget #topRow uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleInsetLeft: 4;
}

uise--AudioPlayerWidget #bottomRow uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleInsetRight: 4;
}

/*
 * The speed button shows text, so the general rule for buttons with text (ripple.qss) gives it a flat ellipse.
 * Its ripple is a circle instead, the size of the halo of the 20 px icon buttons beside it, hence the height
 * of the button. A circle needs a square to grow in and a button as wide as its text is not one, so the
 * ripple is a capsule with equal scales on a square cut out of the overlay, and that is done in
 * AudioPlayerWidget (centerRippleOnText()): it sets rippleInsetLeft/Right from where the text really is.
 * Nothing here may set those two, the code would be fighting the style sheet.
 */
uise--AudioPlayerWidget #speedButton {
    padding: 0 4px;
    min-height: 20px;
    max-height: 20px;
}

uise--AudioPlayerWidget #speedButton uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

uise--AudioPlayerWidget #positionLabel,
uise--AudioPlayerWidget #durationLabel {
    margin: 0 8px;
    min-width: 32px;
}

/* the volume popup is a top-level frame, so it is reached by its own names */
uise--DropdownFrame#volumeDropdown {
    padding: 6px;
    border: 1px solid;
    border-radius: 6px;
}

#volumePopup {
    padding: 4px 0;
}

#volumePopup #volumeSlider {
    min-height: 88px;
    min-width: 20px;
}

#volumePopup #volumeSlider::groove:vertical {
    width: 4px;
    border-radius: 2px;
}

#volumePopup #volumeSlider::sub-page:vertical,
#volumePopup #volumeSlider::add-page:vertical {
    border-radius: 2px;
}

#volumePopup #volumeSlider::handle:vertical {
    height: 12px;
    width: 12px;
    margin: 0 -4px;
    border-radius: 6px;
}
