uise--DropdownMenu {
padding:8px;
border:1px solid;
border-radius:6px;
qproperty-offsetX: 0;
qproperty-offsetY: 4;
qproperty-animationDurationMs: 150;
qproperty-easingCurveType: 6;
}

uise--DropdownMenu #menuContent {
padding:0;
margin:0;
}

uise--DropdownMenu #separator {
min-height:1px;
max-height:1px;
border:none;
margin-top:4px;
margin-bottom:4px;
}

uise--DropdownMenu uise--IconTextButton uise--RoundedImage {
min-width:20px;
max-width:20px;
min-height:20px;
max-height:20px;
}

uise--DropdownMenu uise--IconTextButton #text {
margin-left:8px;
}

/* padding and border are declared explicitly and unconditionally (identical whether
   hovered/checked or not) so that adding a hover/checked background-color below never
   changes a row's effective box model -- only its color -- and never shifts its siblings */
uise--DropdownMenu uise--IconTextButton {
padding:6px 8px;
border-radius:4px;
border:1px solid transparent;
}

/* section headers (MenuItem::section()) -- these selectors carry an attribute so they
   outrank the plain uise--IconTextButton padding rule above instead of tying with it */
uise--DropdownMenu uise--IconTextButton[section="true"] {
padding-left:8px;
margin-top:8px;
}

uise--DropdownMenu uise--IconTextButton[section="true"][firstItem="true"] {
margin-top:0px;
}

uise--DropdownMenu uise--IconTextButton[section="true"] #text {
font-size:16px;
}

/* the row's ripple covers padding but not margin, so the top margin above must be excluded
   from the ripple rect or the halo bleeds above the button */
uise--DropdownMenu uise--IconTextButton[section="true"] uise--RippleOverlay {
qproperty-rippleInsetTop: 8;
}

uise--DropdownMenu uise--IconTextButton[section="true"][firstItem="true"] uise--RippleOverlay {
qproperty-rippleInsetTop: 0;
}

/* ordinary rows that follow a section, until the next separator or section */
uise--DropdownMenu uise--IconTextButton[subsection="true"] {
padding-left:24px;
}
