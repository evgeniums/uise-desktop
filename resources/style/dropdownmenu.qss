uise--DropdownMenu {
padding:8px;
border:1px solid;
border-radius:6px;
qproperty-offsetX: 0;
qproperty-offsetY: 4;
qproperty-animationDurationMs: 150;
qproperty-easingCurveType: 6;
}

uise--DropdownMenu #menuContent {
padding:0;
margin:0;
}

uise--DropdownMenu #separator {
min-height:1px;
max-height:1px;
border:none;
margin-top:4px;
margin-bottom:4px;
}

uise--DropdownMenu uise--IconTextButton uise--RoundedImage {
min-width:20px;
max-width:20px;
min-height:20px;
max-height:20px;
}

uise--DropdownMenu uise--IconTextButton #text {
margin-left:8px;
}

/* padding and border are declared explicitly and unconditionally (identical whether
   hovered/checked or not) so that adding a hover/checked background-color below never
   changes a row's effective box model -- only its color -- and never shifts its siblings */
uise--DropdownMenu uise--IconTextButton {
padding:6px 8px;
border-radius:4px;
border:1px solid transparent;
}
