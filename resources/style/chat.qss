uise--ChatMessageText uise--ChatMessageTextBrowser {
border-radius:0;
background-color: transparent;
border:none;
/* Drops the TOP side of QTextDocument's own documentMargin (4px, uniform on all four sides by
   construction) so the only space above the first line is uise--AbstractChatMessageContent's
   padding-top below. Without this the text sits visibly low in the bubble: the space UNDER it is
   trimmed to qproperty-rowBottomPadding by AbstractChatMessageContent::setMaximumBubbleWidth(),
   which has no counterpart above, so the document margin lands on one side only. The left/right
   inset is deliberately untouched -- it is what gives the text its horizontal breathing room
   inside the bubble's own 4px padding, and the code-block slab's edges are measured from it.
   Scoped under uise--ChatMessageText so the standalone table/code-block viewers, which are bare
   uise--ChatMessageTextBrowser instances, keep Qt's uniform margin. */
qproperty-documentTopMargin: 0;
}

/* Only reachable once a host opts into ChatMessageText::setCopyable(true) (see
   AbstractReplyDialog's static preview) -- Qt.NoFocus (the default) never lets this widget
   gain focus at all. "outline" is Qt QSS's own property for the native focus rectangle Qt
   would otherwise draw around a focused QAbstractScrollArea, distinct from "border". */
uise--ChatMessageText uise--ChatMessageTextBrowser:focus {
border: none;
outline: none;
}

/* task-message-formatting-plan.md, Stage 4. The expand button floated over EVERY table (see
   §4a.6 -- not only ones too wide to fit). It is a child of the browser's viewport anchored to
   the viewport's RIGHT edge -- see ChatMessageTextBrowser::updateTableExpandButtons() for why not
   the table's own right edge.

   Styled after ChatMessageImageItem's own #menuButton (chatmessagefiles.qss), the closest thing
   in the library: another icon-only IconTextButton floated over the top-right of arbitrary
   message content. Same treatment, with one deliberate difference: the backing is OPAQUE rather
   than translucent, because this floats over a table rather than a photo (see the per-theme rules
   for the full reasoning). Otherwise identical -- a backing so the theme-coloured icon stays
   legible over whatever is underneath, no border, and NO hover background: the icon's own hover colour swap (the "hovered" mode in light/chat.json and
   dark/chat.json) is the hover feedback, and that file's own comment records that layering a
   rectangular background behind a rounded control looked wrong on hover/click. Backing colour
   per theme in light/chat.qss and dark/chat.qss. Unlike the expanded viewer's buttons below,
   this is deliberately NOT a dialog button -- it is an overlay on content, not a control in a
   button row. */
uise--ChatMessageTextBrowser #tableExpandButton {
border-radius: 6px;
padding: 4px;
}

/* The floating language + Copy strip over a code block. Structural only -- colours are per theme,
   like every other rule here. It sits INSIDE the painted code-block box (see
   ChatMessageTextBrowser::codeBlockPadding), so it keeps its own padding small: the box's padding
   is already providing the gap to the code. */
uise--ChatMessageTextBrowser #codeBlockOverlay {
border-radius: 4px;
padding: 1px 2px;
}

uise--ChatMessageTextBrowser #codeBlockLanguage {
padding: 0px 4px;
font-size: 10px;
}

/* Both strip buttons share every metric -- they sit side by side in one strip and any difference
   between them would read as a mistake rather than as a distinction. */
uise--ChatMessageTextBrowser #codeBlockCopyButton,
uise--ChatMessageTextBrowser #codeBlockExpandButton {
border-radius: 4px;
padding: 3px;
}

uise--ChatMessageTextBrowser #codeBlockCopyButton #icon,
uise--ChatMessageTextBrowser #codeBlockCopyButton uise--RoundedImage,
uise--ChatMessageTextBrowser #codeBlockExpandButton #icon,
uise--ChatMessageTextBrowser #codeBlockExpandButton uise--RoundedImage {
min-width: 13px;
max-width: 13px;
min-height: 13px;
max-height: 13px;
margin: 0px;
padding: 0px;
}

/* The expanded viewer's Full screen / Copy table / Close row is styled as an ordinary dialog
   button row: 4px radius here matching abstractdialog.qss's own
   "#dialogButtonsFrame uise--PushButton QPushButton {border-radius: 4px; ...}". Padding and
   min-width are deliberately NOT set here -- light/chat.qss and dark/chat.qss set them per theme,
   exactly as light/abstractdialog.qss and dark/abstractdialog.qss do for a real dialog's button
   row (the two themes genuinely use different vertical padding, so a structural value would only
   be overridden anyway). uise--PushButton wraps an inner QPushButton (see
   PushButton::qPushButton()), which is what actually paints -- hence the wrapper/inner split used
   throughout these rules. */
#tableViewerFrame #tableViewerFullScreenButton QPushButton,
#tableViewerFrame #tableViewerCopyButton QPushButton,
#tableViewerFrame #tableViewerCloseButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerFullScreenButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCopyButton QPushButton,
#codeBlockViewerFrame #codeBlockViewerCloseButton QPushButton {
border-radius: 4px;
}

/* Insets the whole row from the window edges, so the last button does not sit flush against the
   right-hand side -- the same job abstractdialog.qss's own
   "#dialogButtonsFrame {padding: 0 4px 4px 4px}" does for a dialog's button row. Doing it here
   rather than as a right margin on the Close button keeps the buttons themselves uniform. */
/* The TOP padding is what keeps the buttons clear of the content above them -- with a horizontal
   scrollbar showing (a wide table, an overflowing code line) that scrollbar is the bottom edge of
   the browser, and the buttons sat directly against it. */
#tableViewerFrame #tableViewerButtons,
#codeBlockViewerFrame #codeBlockViewerButtons {
padding: 12px 8px 12px 8px;
}

/* The browser above the row needs the same inset, or the code's slab runs flush into the window's
   own edges. The table viewer has never needed this (its own document margin plus the table's
   border read as an inset already), but a code block paints an edge-to-edge background. */
#codeBlockViewerFrame uise--ChatMessageTextBrowser {
margin: 8px 8px 0px 8px;
}

/* The uise--PushButton wrappers must stay borderless -- the inner QPushButton above already
   paints the frame, and bordering both draws it twice. Same split as abstractdialog.qss's own
   "#dialogButtonsFrame uise--PushButton {margin} / ... QPushButton {border-radius;padding}",
   where the wrapper carries only the spacing. The left margin is what separates the buttons from
   each other; the row's own padding above handles the distance to the window edges. */
#tableViewerFrame #tableViewerFullScreenButton,
#tableViewerFrame #tableViewerCopyButton,
#tableViewerFrame #tableViewerCloseButton,
#codeBlockViewerFrame #codeBlockViewerFullScreenButton,
#codeBlockViewerFrame #codeBlockViewerCopyButton,
#codeBlockViewerFrame #codeBlockViewerCloseButton {
border: none;
margin: 0px 0px 0px 12px;
}

/* IconTextButton's icon has no sensible default size of its own -- it must be set explicitly per
   container, the same note chatmessagefiles.qss and chatimageviewer.qss carry for their own icon
   buttons. Targeted by the "#icon" objectName IconTextButton gives the wrapper (see
   src/icontextbutton.cpp) as well as the image itself: this button is constructed directly rather
   than through the WidgetFactory, so the uise_type property the "uise--IconTextButton" type
   selector relies on is not set on it and only the object names are dependable here. */
uise--ChatMessageTextBrowser #tableExpandButton #icon,
uise--ChatMessageTextBrowser #tableExpandButton uise--RoundedImage {
min-width: 14px;
max-width: 14px;
min-height: 14px;
max-height: 14px;
margin: 0px;
padding: 0px;
}
/* No explicit box size on the button itself, same as #menuButton: icon size plus the 4px padding
   above is what makes it 22px square, and ChatMessageTextBrowser::updateTableExpandButtons()
   calls adjustSize() so it positions from whatever that comes to. */

/* HARD CONSTRAINT on this radius: the two corners on the SAME edge must sum to no more than the
   bubble's own size along that edge, or Qt does not shrink them to fit -- qNormalizeRadii()
   (qtbase/src/gui/painting/qcssutil.cpp, used by the very path that fills this background) zeroes
   BOTH of them outright, i.e. the edge comes out perfectly square with no warning. The binding
   edge is the vertical one on the FAR side from the tail, where this base radius applies to both
   corners: 2*14=28 against a single-line bubble's 30px, so there is 2px of slack. The near side is
   6px/0px (the [right=...] rules below) and never comes close.

   That is why this is 14 and not 16: a single-line bubble measured 34px while the text carried a
   top document margin, and 2*16=32 fitted by 2px; dropping that margin (qproperty-documentTopMargin
   at the top of this file, which is what vertically centres the text) took the bubble to 30px and
   tipped 32 over the edge -- every single-line bubble lost its far-side corners. Keep 2*radius
   comfortably under the height of a one-line bubble when changing either this or the vertical
   padding/margins, and check a ONE-LINE bubble specifically: a taller one cannot show the fault.

   The other half of this constraint is the SHORTEST bubble, not just the radius: a body that
   renders shorter than a one-line text bubble trips the same qNormalizeRadii() zeroing at an
   unchanged radius. That is exactly what an emoji-only message did -- inline emoji are <img> sized
   to the font's ASCENT (deliberately, so a mixed line is no taller than its neighbours), so a line
   of nothing but emoji has no descent under its baseline and came out ~4px short, squaring both
   far-side corners while every text bubble kept them. Fixed at the source by
   ChatMessageTextBrowser::applyImageLineHeight() (src/chatmessagetext.cpp), which gives an
   image-only block a MINIMUM line height of one text line, so it is now a standing invariant that
   the shortest possible bubble is a one-line text bubble. Anything that breaks that invariant -- a
   new body type, a change to emojiInlineSize, dropping that pass -- puts this radius back at risk.
   Check a ONE-LINE bubble AND an emoji-only (4+ emoji, run together) bubble when changing either
   this or the vertical padding/margins.

   border-radius/padding here stay in effect even for a transparent bubble
   (uise--AbstractChatMessageContent[transparent="true"] in light/chat.qss, dark/chat.qss) -- that
   rule only drops background-color, nothing here. */
uise--AbstractChatMessageContent {
border-radius: 14px;
padding: 4px 4px 0 4px;
}

uise--AbstractChatMessage {
margin-top: 2px;
}

uise--AbstractChatMessage #bottomSpace{
min-height: 6px;
max-height: 6px;
}

/* Tail/corner-radius geometry keys on [right=...] (which side the bubble sits/points to), NOT
 * [sent=...] (colour only, see light/chat.qss and dark/chat.qss) -- own messages can be aligned
 * to the left (AbstractChatMessagesView::AlignSentMode), and a left-aligned sent bubble still
 * needs a left-pointing tail. */
uise--AbstractChatMessageContent[right="true"] {
border-top-right-radius: 6px;
border-bottom-right-radius: 6px;
}

/* Kept equal to the base border-radius above, not an independent value -- this is "the first
   bubble of a batch rounds its near side like its far side", so the two must move together. */
uise--AbstractChatMessageContent[right="true"][first="true"] {
border-top-right-radius: 14px;
}

uise--AbstractChatMessageContent[right="true"][last="true"] {
border-bottom-right-radius: 0;
}


uise--AbstractChatMessageContent[right="false"] {
border-top-left-radius: 6px;
border-bottom-left-radius: 6px;
}

/* Mirror of the [right="true"][first="true"] rule above -- same "equal to the base radius" rule. */
uise--AbstractChatMessageContent[right="false"][first="true"] {
border-top-left-radius: 14px;
}

uise--AbstractChatMessageContent[right="false"][last="true"] {
border-bottom-left-radius: 0;
}


/* #avatarFrame is the plain QFrame placeholder swapped in on the side OPPOSITE the real
 * uise--ChatMessageAvatar column (see ChatMessage::updateAlignment()). Neither one's width comes
 * from QSS -- ChatMessage::updateAvatarForced() gives both a setFixedWidth() every pass, derived
 * from qproperty-forcedAvatarSize/-forcedAvatarMargin below -- so this rule is only the baseline
 * that applies before the first such pass. */
uise--AbstractChatMessage #avatarFrame{
min-width: 16px;
}

/* Tail shape. Painted by ChatMessageAvatar::paintEvent() (src/chatmessage.cpp), replacing the
 * pair of "[right=...][last=true] #mask { border-bottom-*-radius: 16px }" rules that used to
 * carve the tail out of an opaque child painted in the chat-background colour -- that only ever
 * worked because uise--AbstractChatMessagesView's own background was kept in lockstep as a flat
 * colour (see light/chat.qss, dark/chat.qss); any texture, gradient or per-chat background image
 * on the view would show a mismatched slice through that opaque column.
 *
 * tailShape picks the silhouette:
 *   0 (ChatMessageAvatar::TailShapeHook, default)     -- a teardrop hook, thickness set by
 *                                                         tailWidth (tailHeight also scales it).
 *   1 (ChatMessageAvatar::TailShapeRounded)           -- the plain quarter-disc crescent this
 *                                                         class used to fake with #mask; radius
 *                                                         is tailHeight, tailWidth is unused.
 * To get the original rounded tail back project-wide, override just this:
 *   qproperty-tailShape: 1;
 *
 * tailHeight matches uise--AbstractChatMessageContent's border-radius above in both shapes, so
 * the tail continues the bubble's own corner. ChatMessageAvatar::tailPath() clamps the tail to
 * this COLUMN's own rect, so tailHeight (and, for the hook shape, tailWidth) must stay within it
 * -- the column is forcedAvatarSize+2*forcedAvatarMargin wide and
 * forcedAvatarSize+avatarBottomOffset tall, NOT avatarSize in either direction. Which side the
 * tail points to is decided in C++ from ChatMessageAvatar::setRight(), and its colour comes from
 * qproperty-tailColor in light/chat.qss and dark/chat.qss.
 *
 * forcedAvatarSize is the knob for how big the avatar actually LOOKS: the (square) image's side
 * once ChatMessage::updateAvatarForced() forces it visible, i.e. sent and received messages are
 * sharing the same (left) side and so are otherwise indistinguishable by position alone. The
 * avatar itself is shown only on the LAST message of a batch. forcedAvatarMargin is the
 * breathing room on EACH side of it, so the column comes out 24+2*6 = 36px wide.
 *
 * avatarSize, by contrast, is NOT a useful knob here: updateAvatarForced() overwrites it on
 * every pass (with forcedAvatarSize, or with the narrow default on a column that can never hold
 * an avatar), so changing it below has no visible effect. It is left in place as the pre-pass
 * baseline only.
 *
 * Keep these two OUT of light/chat.qss and dark/chat.qss, which carry colour only: the column
 * width they produce is cached per view in ChatMessagesView::m_messageBubbleOuterWidth, sampled
 * from one arbitrary row and refreshed only on an alignment/group-avatar/selection-mode change,
 * so a width that differed between themes would leave every bubble's max width stale after a
 * live theme switch. (The same caveat applies while hot-tuning forcedAvatarSize here: reload,
 * then toggle one of those modes to resettle the widths.)
 *
 * avatarBottomOffset is the distance from the message's BOTTOM edge to the avatar's -- i.e. how
 * far above the tail the avatar sits. Raise it to lift the avatar, lower it to drop it towards
 * the tail. Note it does NOT have to clear tailHeight: the rounded tail is a concave disc carved
 * out of the corner, so what matters is that the round avatar stays inside that disc (see the
 * invariants on ChatMessageAvatar::forcedAvatarSize) -- 6 against a tailHeight of 20 clears it.
 *
 * Together with forcedAvatarSize it also sets the column's HEIGHT, and that is the number to be
 * careful with: 24+6 = 30px here, against a one-line text bubble that measures 30px of painted
 * box and ~33px of layout height -- i.e. sized to sit just under it, with nothing to spare.
 * Raise either one and the column becomes taller than such a bubble, at which point
 * AbstractChatMessageContent::setMinimumBubbleHeight() has to reserve the shortfall as blank
 * space at the bubble's top -- which reads as a bigger gap in front of the LAST message of every
 * batch, not as "that bubble is slightly taller". Re-check this whenever the bubble padding or
 * border-radius above changes. */
uise--AbstractChatMessage uise--ChatMessageAvatar {
qproperty-tailShape: 1;
qproperty-tailWidth: 10;
qproperty-tailHeight: 20;
qproperty-avatarSize: 16;
qproperty-forcedAvatarSize: 24;
qproperty-forcedAvatarMargin: 6;
qproperty-avatarBottomOffset: 6;
}

uise--AbstractChatSeparatorSection {
margin: 8px 0;
}

uise--AbstractChatSeparatorSection uise--AvatarButton {
padding: 5px 20px;
border-radius: 10px;
border: none;
}

uise--AbstractChatSeparatorSection uise--AvatarButton #text {
font-weight: bold;
}

/*
 * ChatDateSubtitle - floating date pill over the chat messages viewport.
 * Colours come from the uise--ChatSeparatorSection rules in light/chat.qss and dark/chat.qss,
 * inherited through the ChatSeparatorSection it wraps.
 */
uise--ChatDateSubtitle {
qproperty-showDelayMs: 150;
qproperty-hideDelayMs: 1200;
qproperty-fadeInDurationMs: 150;
qproperty-fadeOutDurationMs: 300;
qproperty-topOffset: 0;
qproperty-occlusionMargin: 4;
background-color: transparent;
border: none;
}

/*
 * ChatFloatingAvatar - sender avatar pinned near the bottom of the chat messages viewport,
 * standing in for the batch's own anchored avatar (on its LAST message, beside the tail) while
 * that one is scrolled out of sight. Shown whenever avatars are on at all, i.e. own and received
 * messages share the left side (ChatMessage::updateAvatarForced()'s leftAligned half).
 *
 * It does NOT fade back out when the anchored avatar returns to the viewport: the handoff runs the
 * other way, with ChatMessagesView::updateFloatingAvatar() instantly hiding the covered row's own
 * avatar (AbstractChatMessage::setAvatarObscured()) so exactly one avatar renders at that spot,
 * and this one just keeps tracking smoothly. Fading it out at the handoff instead is what used to
 * flicker at a batch boundary.
 *
 * There is deliberately NO qproperty-avatarSize (nor -forcedAvatarSize) here, unlike
 * uise--ChatMessageAvatar above: the floating copy re-reads its size from the message it
 * represents on every update pass instead, so it follows forcedAvatarSize automatically and can
 * never be silently shrunk back to a stylesheet default by an app-wide restyle the way the
 * anchored avatar can (see ChatMessage::changeEvent()'s own doc comment on that trap).
 *
 * bottomOffset is the gap from the viewport's bottom edge to the avatar's, in its natural resting
 * position. It is pulled UP from there onto the batch tail's own anchored avatar once that has
 * scrolled far enough in (so the two coincide exactly and the swap is invisible), and pushed DOWN
 * past it, clipped by the viewport, once the batch's first bubble scrolls below it.
 * occlusionMargin is vertical slack added around this copy's own rect when testing which row's
 * anchored avatar it is covering, so that choice does not chatter right at the boundary.
 * showDelayMs/hideDelayMs/fadeIn/fadeOutDurationMs are all 0, i.e. this copy appears and
 * disappears instantly: it does so in the very same pass that hides (or restores) the avatar of
 * the row it stands in for, and in the same place, so any delay or fade there is visible as a
 * blink with neither avatar on screen -- which is exactly what a 150ms fade-in did on chat
 * reload. They stay as knobs only so a host can opt back in. Unlike the date pill this avatar is
 * also not tied to a scroll session -- it stays up for as long as its conditions hold.
 *
 * modeChangeBlockMs is the one deliberate delay: when the chat switches between showing and
 * hiding per-message avatars ("Position of my messages", or an Auto-mode resize crossing
 * alignSentLeftWidth above) every row relayouts, so this copy is parked and the rows carry their
 * own avatars for that long before it is placed again. */
uise--ChatFloatingAvatar {
qproperty-showDelayMs: 0;
qproperty-hideDelayMs: 0;
qproperty-fadeInDurationMs: 0;
qproperty-fadeOutDurationMs: 0;
qproperty-bottomOffset: 8;
qproperty-occlusionMargin: 4;
qproperty-modeChangeBlockMs: 400;
background-color: transparent;
border: none;
padding: 0px;
margin: 0px;
}

/* The list itself is uncapped -- the bubble width cap moved onto qproperty-maxMessageWidth so a
 * wide window is actually used (AbstractChatMessagesView::setMaxMessageWidth()).
 * qproperty-alignSentLeftWidth is the Auto-mode threshold (AlignSentMode::Auto): past this view
 * width, own messages move to the left so they line up with received ones (0 = never). See
 * whitemdesktop's Appearance node ("Position of my messages"). */
uise--AbstractChatMessagesView {
qproperty-maxMessageWidth: 1000;
qproperty-alignSentLeftWidth: 1000;
}

uise--AbstractChatMessageSelector {
min-width: 40px;
max-width: 40px;
}

/* rowMinWidth replaces a plain "min-width" here: this row can also be placed manually, tucked
 * into the trailing space of the message's last text line (AbstractChatMessageContent's inline-
 * bottom mechanism -- see ChatMessageBottom::naturalSize()/bubbleWidthHint()) rather than filling
 * a full-width row of its own, and QWidget::setGeometry() would otherwise clamp that manual
 * placement to a plain QSS min-width regardless of who set the geometry. rowMinWidth only floors
 * the ROW-mode width (ChatMessageBottom::bubbleWidthHint()'s own fallback branch); it has no
 * effect on the row's natural (inline) size. inlineBottomGap is the horizontal gap between the
 * last line's own right edge and the row when inline -- independent of narrowBodyWidth's gap
 * (BottomGap in chatmessage.cpp), which only applies to the full-width-row widening case.
 * inlineBottomYOffset nudges the inline row DOWN from its natural bottom-aligned-with-the-last-
 * line position (see ChatMessageContent::positionBottom()) -- purely bottom-aligned reads as
 * sitting slightly too high above the text's own descenders.
 *
 * rowBottomPadding is THE knob for the space under the bubble's bottom row, in both modes --
 * uise--AbstractChatMessageContent's own bottom padding is not (it is 0 above, and inline the row
 * sits inside the trailing text's own dead space, which the bubble is trimmed to instead). The
 * gap that reads visually is a couple of px larger, since the row's own ink stops short of its
 * box edge. rowTopGap is its counterpart above the row, row mode only.
 *
 * chipPadding is unrelated to all of the above -- it only applies while this row is in "chip"
 * mode (uise--ChatMessageBottom[chip="true"] below), i.e. sitting on a transparent bubble
 * (AbstractChatMessageContent::isBubbleTransparent()) and painting its OWN small rounded
 * background rather than relying on the bubble's. It pads the row on ALL FOUR sides -- both the
 * space the chip's background is drawn into and, via AbstractChatMessageBottom::placedSize(), the
 * extra size reserved for the row wherever bottomNaturalSize()/bubbleWidthHint() feed into the
 * bubble's own width/height negotiation. */
uise--AbstractChatMessageBottom {
qproperty-rowMinWidth: 90;
qproperty-narrowBodyWidth: 200;
qproperty-inlineBottomGap: 10;
qproperty-inlineBottomYOffset: 1;
qproperty-rowTopGap: 4;
qproperty-rowBottomPadding: 4;
qproperty-chipPadding: 4;
}

/* Do NOT add a `padding` rule for uise--ChatMessageBottom here: the row is placed explicitly
 * (ChatMessageContent::positionBottom()), sized to its own naturalSize()/placedSize(), so QSS
 * padding -- which lands on that same widget's contentsMargins -- would be counted twice and
 * re-introduce exactly the squeezed/clipped row this replaced. Tune qproperty-rowTopGap/
 * qproperty-rowBottomPadding (ordinary bubble) or qproperty-chipPadding (chip mode) above instead
 * -- ChatMessageContent::updateBottomPlacement() is the one place that ever sets this row's
 * contentsMargins, from exactly those properties. */

/* The small rounded chip a transparent bubble's bottom row paints behind itself once hovered --
 * see uise--AbstractChatMessageContent[transparent="true"] (light/chat.qss, dark/chat.qss) for
 * the bubble side of the same feature. Colour lives in light/chat.qss and dark/chat.qss, paired
 * with that rule the same way the bubble's own [sent]/[selected] colours are paired with their
 * tail colours. Radius is deliberately its own value, not tailHeight/border-radius above -- this
 * is a small standalone pill, not a corner of anything. */
uise--ChatMessageBottom[chip="true"] {
border-radius: 9px;
}

/* Hard cap on rendered text width -- a bubble that fills a wide window produces unreadably long
 * lines. Matches ChatMessageText both as a message body and as the comment inside an image album
 * or file list; 0 disables the cap. The album/file rows themselves are not affected. */
uise--AbstractChatMessageText {
qproperty-maxBubbleWidth: 500;
}

/* Jump-to-message highlight timing -- theme-independent, colour lives in light/chat.qss and
 * dark/chat.qss (see AbstractChatMessage::startHighlight()). Snaps to full, holds
 * highlightHoldMs so the eye catches it once the jump's own scroll settles, then fades over
 * highlightFadeMs. qproperty-highlightEasingCurveType is QEasingCurve::Type as int
 * (6=OutCubic), same qproperty-*EasingCurveType idiom as RippleOverlay (see ripple.qss). */
uise--AbstractChatMessage {
qproperty-selectorPositionLeft: false;
min-width: 400px;
qproperty-highlightHoldMs: 400;
qproperty-highlightFadeMs: 1200;
qproperty-highlightEasingCurveType: 6;
}

/* ChatMessageSelector is a uise--CheckBox styled as a round, glyph-less selection dot -- see
 * checkbox.qss for the #indicator/#indicatorOff/#indicatorOn/#markIcon/#mark structure this
 * overrides. The mark is collapsed to zero size (there is no glyph here, just a filled dot,
 * matching the previous QCheckBox::indicator's "image: none") rather than hidden, so it never
 * affects the layout regardless of indicatorMode. */
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicator {
min-width:18px; max-width:18px;
min-height:18px; max-height:18px;
padding:5px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
min-width:14px; max-width:14px;
min-height:14px; max-height:14px;
border-radius: 9px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #markIcon,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #mark {
min-width:0; max-width:0;
min-height:0; max-height:0;
}

uise--ChatMessageBottom uise--IconTextButton #icon,
uise--ChatMessageBottom uise--IconTextButton #text{
margin:0;
padding:0;
}

uise--AbstractChatMessage uise--AbstractChatMessageContent uise--ChatMessageBottom QLabel {
font-size: 13px;
}

uise--ChatMessageBottom #time {
margin-right:1px;
}

uise--ChatMessageBottom #status {
margin-left:0;
margin-right:2px;
}

/* The "edited" marker sits immediately before #time in the bottom row's layout, which has no
 * spacing of its own -- without this the two run together as "editedhh:mm". Colour/size are
 * deliberately not set here: the generic "uise--ChatMessageBottom QLabel" rule in light/chat.qss
 * and dark/chat.qss already covers both this label and #time, so the marker matches the time it
 * sits next to by construction. */
uise--ChatMessageBottom #edited {
margin-right:1px;
}

uise--ChatMessageBottom uise--WithRoundedImage,
uise--ChatMessageBottom uise--RoundedImage {
min-width: 16px;
max-width: 16px;
min-height: 16px;
max-height: 16px;
}

uise--MessageSelectionPanelUi #drawer {
padding: 0 4px;
border-top-left-radius: 4px;
border-bottom-left-radius: 4px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton {
margin: 0 6px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
padding: 6px 10px;
border-radius: 4px;
min-width:100px;
}

/* border-radius above is 6px, not the 4px ripple.qss assumes for uise--PushButton -- override
 * rippleCornerRadius to match so the rounded ripple clip lines up with the button's own corners. */
uise--MessageSelectionPanelUi #drawer uise--PushButton uise--RippleOverlay {
qproperty-rippleCornerRadius: 6;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
/*
font-size: 18px;
*/
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
min-width:0;
}
