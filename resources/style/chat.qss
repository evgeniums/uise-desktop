uise--ChatMessageText uise--ChatMessageTextBrowser {
border-radius:0;
background-color: transparent;
border:none;
}

/* Only reachable once a host opts into ChatMessageText::setCopyable(true) (see
   AbstractReplyDialog's static preview) -- Qt.NoFocus (the default) never lets this widget
   gain focus at all. "outline" is Qt QSS's own property for the native focus rectangle Qt
   would otherwise draw around a focused QAbstractScrollArea, distinct from "border". */
uise--ChatMessageText uise--ChatMessageTextBrowser:focus {
border: none;
outline: none;
}

uise--AbstractChatMessageContent {
border-radius: 16px;
padding: 8px;
}

uise--AbstractChatMessage {
margin-top: 2px;
}

uise--AbstractChatMessage #bottomSpace{
min-height: 6px;
max-height: 6px;
}

/* Tail/corner-radius geometry keys on [right=...] (which side the bubble sits/points to), NOT
 * [sent=...] (colour only, see light/chat.qss and dark/chat.qss) -- own messages can be aligned
 * to the left (AbstractChatMessagesView::AlignSentMode), and a left-aligned sent bubble still
 * needs a left-pointing tail. */
uise--AbstractChatMessageContent[right="true"] {
border-top-right-radius: 6px;
border-bottom-right-radius: 6px;
}

uise--AbstractChatMessageContent[right="true"][first="true"] {
border-top-right-radius: 16px;
}

uise--AbstractChatMessageContent[right="true"][last="true"] {
border-bottom-right-radius: 0;
}


uise--AbstractChatMessageContent[right="false"] {
border-top-left-radius: 6px;
border-bottom-left-radius: 6px;
}

uise--AbstractChatMessageContent[right="false"][first="true"] {
border-top-left-radius: 16px;
}

uise--AbstractChatMessageContent[right="false"][last="true"] {
border-bottom-left-radius: 0;
}


uise--AbstractChatMessage uise--ChatMessageAvatar,
uise--AbstractChatMessage #avatarFrame{
min-width: 16px;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[right="true"][last="true"] #mask{
border-radius:0;
border-bottom-left-radius: 16px;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[right="false"][last="true"] #mask{
border-radius:0;
border-bottom-right-radius: 16px;
}

uise--AbstractChatSeparatorSection {
margin: 8px 0;
}

uise--AbstractChatSeparatorSection uise--AvatarButton {
padding: 5px 20px;
border-radius: 10px;
border: none;
}

uise--AbstractChatSeparatorSection uise--AvatarButton #text {
font-weight: bold;
}

/*
 * ChatDateSubtitle - floating date pill over the chat messages viewport.
 * Colours come from the uise--ChatSeparatorSection rules in light/chat.qss and dark/chat.qss,
 * inherited through the ChatSeparatorSection it wraps.
 */
uise--ChatDateSubtitle {
qproperty-showDelayMs: 150;
qproperty-hideDelayMs: 1200;
qproperty-fadeInDurationMs: 150;
qproperty-fadeOutDurationMs: 300;
qproperty-topOffset: 0;
qproperty-occlusionMargin: 4;
background-color: transparent;
border: none;
}

/* The list itself is uncapped -- the bubble width cap moved onto qproperty-maxMessageWidth so a
 * wide window is actually used (AbstractChatMessagesView::setMaxMessageWidth()).
 * qproperty-alignSentLeftWidth is the Auto-mode threshold (AlignSentMode::Auto): past this view
 * width, own messages move to the left so they line up with received ones (0 = never). See
 * whitemdesktop's Appearance node ("Position of my messages"). */
uise--AbstractChatMessagesView {
qproperty-maxMessageWidth: 1000;
qproperty-alignSentLeftWidth: 1000;
}

uise--AbstractChatMessageSelector {
min-width: 40px;
max-width: 40px;
}

uise--AbstractChatMessageBottom {
min-width: 90px;
qproperty-narrowBodyWidth: 200;
}

/* Hard cap on rendered text width -- a bubble that fills a wide window produces unreadably long
 * lines. Matches ChatMessageText both as a message body and as the comment inside an image album
 * or file list; 0 disables the cap. The album/file rows themselves are not affected. */
uise--AbstractChatMessageText {
qproperty-maxBubbleWidth: 600;
}

/* Jump-to-message highlight timing -- theme-independent, colour lives in light/chat.qss and
 * dark/chat.qss (see AbstractChatMessage::startHighlight()). Snaps to full, holds
 * highlightHoldMs so the eye catches it once the jump's own scroll settles, then fades over
 * highlightFadeMs. qproperty-highlightEasingCurveType is QEasingCurve::Type as int
 * (6=OutCubic), same qproperty-*EasingCurveType idiom as RippleOverlay (see ripple.qss). */
uise--AbstractChatMessage {
qproperty-selectorPositionLeft: false;
min-width: 400px;
qproperty-highlightHoldMs: 400;
qproperty-highlightFadeMs: 1200;
qproperty-highlightEasingCurveType: 6;
}

/* ChatMessageSelector is a uise--CheckBox styled as a round, glyph-less selection dot -- see
 * checkbox.qss for the #indicator/#indicatorOff/#indicatorOn/#markIcon/#mark structure this
 * overrides. The mark is collapsed to zero size (there is no glyph here, just a filled dot,
 * matching the previous QCheckBox::indicator's "image: none") rather than hidden, so it never
 * affects the layout regardless of indicatorMode. */
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicator {
min-width:18px; max-width:18px;
min-height:18px; max-height:18px;
padding:5px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
min-width:14px; max-width:14px;
min-height:14px; max-height:14px;
border-radius: 9px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #markIcon,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #mark {
min-width:0; max-width:0;
min-height:0; max-height:0;
}

uise--ChatMessageBottom uise--IconTextButton #icon,
uise--ChatMessageBottom uise--IconTextButton #text{
margin:0;
padding:0;
}

uise--ChatMessageBottom #status {
margin-left:8px;
margin-right:0;
}

/* The "edited" marker sits immediately before #time in the bottom row's layout, which has no
 * spacing of its own -- without this the two run together as "editedhh:mm". Colour/size are
 * deliberately not set here: the generic "uise--ChatMessageBottom QLabel" rule in light/chat.qss
 * and dark/chat.qss already covers both this label and #time, so the marker matches the time it
 * sits next to by construction. */
uise--ChatMessageBottom #edited {
margin-right:5px;
}

uise--ChatMessageBottom uise--WithRoundedImage,
uise--ChatMessageBottom uise--RoundedImage {
min-width: 16px;
max-width: 16px;
min-height: 16px;
max-height: 16px;
}

uise--MessageSelectionPanelUi #drawer {
padding: 0 4px;
border-top-left-radius: 4px;
border-bottom-left-radius: 4px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton {
margin: 0 6px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
padding: 6px 10px;
border-radius: 6px;
min-width:100px;
}

/* border-radius above is 6px, not the 4px ripple.qss assumes for uise--PushButton -- override
 * rippleCornerRadius to match so the rounded ripple clip lines up with the button's own corners. */
uise--MessageSelectionPanelUi #drawer uise--PushButton uise--RippleOverlay {
qproperty-rippleCornerRadius: 6;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
/*
font-size: 18px;
*/
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
min-width:0;
}
