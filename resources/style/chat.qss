uise--ChatMessageText uise--ChatMessageTextBrowser {
border-radius:0;
background-color: transparent;
border:none;
}

/* Only reachable once a host opts into ChatMessageText::setCopyable(true) (see
   AbstractReplyDialog's static preview) -- Qt.NoFocus (the default) never lets this widget
   gain focus at all. "outline" is Qt QSS's own property for the native focus rectangle Qt
   would otherwise draw around a focused QAbstractScrollArea, distinct from "border". */
uise--ChatMessageText uise--ChatMessageTextBrowser:focus {
border: none;
outline: none;
}

uise--AbstractChatMessageContent {
border-radius: 16px;
padding: 8px;
}

uise--AbstractChatMessage {
margin-top: 2px;
}

uise--AbstractChatMessage #bottomSpace{
min-height: 6px;
max-height: 6px;
}

/* Tail/corner-radius geometry keys on [right=...] (which side the bubble sits/points to), NOT
 * [sent=...] (colour only, see light/chat.qss and dark/chat.qss) -- own messages can be aligned
 * to the left (AbstractChatMessagesView::AlignSentMode), and a left-aligned sent bubble still
 * needs a left-pointing tail. */
uise--AbstractChatMessageContent[right="true"] {
border-top-right-radius: 6px;
border-bottom-right-radius: 6px;
}

uise--AbstractChatMessageContent[right="true"][first="true"] {
border-top-right-radius: 16px;
}

uise--AbstractChatMessageContent[right="true"][last="true"] {
border-bottom-right-radius: 0;
}


uise--AbstractChatMessageContent[right="false"] {
border-top-left-radius: 6px;
border-bottom-left-radius: 6px;
}

uise--AbstractChatMessageContent[right="false"][first="true"] {
border-top-left-radius: 16px;
}

uise--AbstractChatMessageContent[right="false"][last="true"] {
border-bottom-left-radius: 0;
}


/* uise--ChatMessageAvatar's own default width now comes from qproperty-avatarSize below (also
 * the side of the square avatar image itself, when ChatMessage::updateAlignment() forces it
 * visible) -- #avatarFrame is the plain QFrame placeholder swapped in on the OTHER side (see
 * ChatMessage::updateAlignment()), which has no such qproperty and needs its own rule to match. */
uise--AbstractChatMessage #avatarFrame{
min-width: 16px;
}

/* Tail shape. Painted by ChatMessageAvatar::paintEvent() (src/chatmessage.cpp), replacing the
 * pair of "[right=...][last=true] #mask { border-bottom-*-radius: 16px }" rules that used to
 * carve the tail out of an opaque child painted in the chat-background colour -- that only ever
 * worked because uise--AbstractChatMessagesView's own background was kept in lockstep as a flat
 * colour (see light/chat.qss, dark/chat.qss); any texture, gradient or per-chat background image
 * on the view would show a mismatched slice through that opaque column.
 *
 * tailShape picks the silhouette:
 *   0 (ChatMessageAvatar::TailShapeHook, default)     -- a teardrop hook, thickness set by
 *                                                         tailWidth (tailHeight also scales it).
 *   1 (ChatMessageAvatar::TailShapeRounded)           -- the plain quarter-disc crescent this
 *                                                         class used to fake with #mask; radius
 *                                                         is tailHeight, tailWidth is unused.
 * To get the original rounded tail back project-wide, override just this:
 *   qproperty-tailShape: 1;
 *
 * tailHeight matches uise--AbstractChatMessageContent's border-radius above in both shapes, so
 * the tail continues the bubble's own corner; it (and, for the hook shape, tailWidth) must stay
 * <= avatarSize (below) or the tip is clipped. Which side the tail points to is decided in C++
 * from ChatMessageAvatar::setRight(), and its colour comes from qproperty-tailColor in
 * light/chat.qss and dark/chat.qss.
 *
 * avatarSize is the (square) avatar image's own side -- NOT this column's width, which
 * ChatMessage::updateAvatarForced() sets separately (the avatar plus ForcedAvatarMargin on each
 * side). Both are widened together once that method forces the avatar image on, i.e. sent and
 * received messages are sharing the same (left) side and so are otherwise indistinguishable by
 * position alone; the avatar itself is shown only on the LAST message of a batch.
 *
 * avatarBottomOffset is the distance from the message's BOTTOM edge to the avatar's -- i.e. how
 * far above the tail the avatar sits. Raise it to lift the avatar, lower it to drop it towards
 * the tail; keep it >= tailHeight or the avatar starts overlapping the tail. */
uise--AbstractChatMessage uise--ChatMessageAvatar {
qproperty-tailShape: 1;
qproperty-tailWidth: 10;
qproperty-tailHeight: 20;
qproperty-avatarSize: 16;
qproperty-avatarBottomOffset: 6;
}

uise--AbstractChatSeparatorSection {
margin: 8px 0;
}

uise--AbstractChatSeparatorSection uise--AvatarButton {
padding: 5px 20px;
border-radius: 10px;
border: none;
}

uise--AbstractChatSeparatorSection uise--AvatarButton #text {
font-weight: bold;
}

/*
 * ChatDateSubtitle - floating date pill over the chat messages viewport.
 * Colours come from the uise--ChatSeparatorSection rules in light/chat.qss and dark/chat.qss,
 * inherited through the ChatSeparatorSection it wraps.
 */
uise--ChatDateSubtitle {
qproperty-showDelayMs: 150;
qproperty-hideDelayMs: 1200;
qproperty-fadeInDurationMs: 150;
qproperty-fadeOutDurationMs: 300;
qproperty-topOffset: 0;
qproperty-occlusionMargin: 4;
background-color: transparent;
border: none;
}

/*
 * ChatFloatingAvatar - sender avatar pinned near the bottom of the chat messages viewport,
 * standing in for the batch's own anchored avatar (on its LAST message, beside the tail) while
 * that one is scrolled out of sight. Shown whenever avatars are on at all, i.e. own and received
 * messages share the left side (ChatMessage::updateAvatarForced()'s leftAligned half).
 *
 * It does NOT fade back out when the anchored avatar returns to the viewport: the handoff runs the
 * other way, with ChatMessagesView::updateFloatingAvatar() instantly hiding the covered row's own
 * avatar (AbstractChatMessage::setAvatarObscured()) so exactly one avatar renders at that spot,
 * and this one just keeps tracking smoothly. Fading it out at the handoff instead is what used to
 * flicker at a batch boundary.
 *
 * There is deliberately NO qproperty-avatarSize here, unlike uise--ChatMessageAvatar above: the
 * floating copy re-reads its size from the message it represents on every update pass instead, so
 * it can never be silently shrunk back to a stylesheet default by an app-wide restyle the way the
 * anchored avatar can (see ChatMessage::changeEvent()'s own doc comment on that trap).
 *
 * bottomOffset is the gap from the viewport's bottom edge to the avatar's, in its natural resting
 * position. It is pulled UP from there onto the batch tail's own anchored avatar once that has
 * scrolled far enough in (so the two coincide exactly and the swap is invisible), and pushed DOWN
 * past it, clipped by the viewport, once the batch's first bubble scrolls below it.
 * occlusionMargin is vertical slack added around this copy's own rect when testing which row's
 * anchored avatar it is covering, so that choice does not chatter right at the boundary.
 * showDelayMs/hideDelayMs/fadeIn/fadeOutDurationMs are all 0, i.e. this copy appears and
 * disappears instantly: it does so in the very same pass that hides (or restores) the avatar of
 * the row it stands in for, and in the same place, so any delay or fade there is visible as a
 * blink with neither avatar on screen -- which is exactly what a 150ms fade-in did on chat
 * reload. They stay as knobs only so a host can opt back in. Unlike the date pill this avatar is
 * also not tied to a scroll session -- it stays up for as long as its conditions hold.
 *
 * modeChangeBlockMs is the one deliberate delay: when the chat switches between showing and
 * hiding per-message avatars ("Position of my messages", or an Auto-mode resize crossing
 * alignSentLeftWidth above) every row relayouts, so this copy is parked and the rows carry their
 * own avatars for that long before it is placed again. */
uise--ChatFloatingAvatar {
qproperty-showDelayMs: 0;
qproperty-hideDelayMs: 0;
qproperty-fadeInDurationMs: 0;
qproperty-fadeOutDurationMs: 0;
qproperty-bottomOffset: 8;
qproperty-occlusionMargin: 4;
qproperty-modeChangeBlockMs: 400;
background-color: transparent;
border: none;
padding: 0px;
margin: 0px;
}

/* The list itself is uncapped -- the bubble width cap moved onto qproperty-maxMessageWidth so a
 * wide window is actually used (AbstractChatMessagesView::setMaxMessageWidth()).
 * qproperty-alignSentLeftWidth is the Auto-mode threshold (AlignSentMode::Auto): past this view
 * width, own messages move to the left so they line up with received ones (0 = never). See
 * whitemdesktop's Appearance node ("Position of my messages"). */
uise--AbstractChatMessagesView {
qproperty-maxMessageWidth: 1000;
qproperty-alignSentLeftWidth: 1000;
}

uise--AbstractChatMessageSelector {
min-width: 40px;
max-width: 40px;
}

uise--AbstractChatMessageBottom {
min-width: 90px;
qproperty-narrowBodyWidth: 200;
}

/* Hard cap on rendered text width -- a bubble that fills a wide window produces unreadably long
 * lines. Matches ChatMessageText both as a message body and as the comment inside an image album
 * or file list; 0 disables the cap. The album/file rows themselves are not affected. */
uise--AbstractChatMessageText {
qproperty-maxBubbleWidth: 600;
}

/* Jump-to-message highlight timing -- theme-independent, colour lives in light/chat.qss and
 * dark/chat.qss (see AbstractChatMessage::startHighlight()). Snaps to full, holds
 * highlightHoldMs so the eye catches it once the jump's own scroll settles, then fades over
 * highlightFadeMs. qproperty-highlightEasingCurveType is QEasingCurve::Type as int
 * (6=OutCubic), same qproperty-*EasingCurveType idiom as RippleOverlay (see ripple.qss). */
uise--AbstractChatMessage {
qproperty-selectorPositionLeft: false;
min-width: 400px;
qproperty-highlightHoldMs: 400;
qproperty-highlightFadeMs: 1200;
qproperty-highlightEasingCurveType: 6;
}

/* ChatMessageSelector is a uise--CheckBox styled as a round, glyph-less selection dot -- see
 * checkbox.qss for the #indicator/#indicatorOff/#indicatorOn/#markIcon/#mark structure this
 * overrides. The mark is collapsed to zero size (there is no glyph here, just a filled dot,
 * matching the previous QCheckBox::indicator's "image: none") rather than hidden, so it never
 * affects the layout regardless of indicatorMode. */
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicator {
min-width:18px; max-width:18px;
min-height:18px; max-height:18px;
padding:5px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
min-width:14px; max-width:14px;
min-height:14px; max-height:14px;
border-radius: 9px;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #markIcon,
uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #mark {
min-width:0; max-width:0;
min-height:0; max-height:0;
}

uise--ChatMessageBottom uise--IconTextButton #icon,
uise--ChatMessageBottom uise--IconTextButton #text{
margin:0;
padding:0;
}

uise--ChatMessageBottom #status {
margin-left:8px;
margin-right:0;
}

/* The "edited" marker sits immediately before #time in the bottom row's layout, which has no
 * spacing of its own -- without this the two run together as "editedhh:mm". Colour/size are
 * deliberately not set here: the generic "uise--ChatMessageBottom QLabel" rule in light/chat.qss
 * and dark/chat.qss already covers both this label and #time, so the marker matches the time it
 * sits next to by construction. */
uise--ChatMessageBottom #edited {
margin-right:5px;
}

uise--ChatMessageBottom uise--WithRoundedImage,
uise--ChatMessageBottom uise--RoundedImage {
min-width: 18px;
max-width: 18px;
min-height: 18px;
max-height: 18px;
}

uise--MessageSelectionPanelUi #drawer {
padding: 0 4px;
border-top-left-radius: 4px;
border-bottom-left-radius: 4px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton {
margin: 0 6px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
padding: 6px 10px;
border-radius: 4px;
min-width:100px;
}

/* border-radius above is 6px, not the 4px ripple.qss assumes for uise--PushButton -- override
 * rippleCornerRadius to match so the rounded ripple clip lines up with the button's own corners. */
uise--MessageSelectionPanelUi #drawer uise--PushButton uise--RippleOverlay {
qproperty-rippleCornerRadius: 6;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
/*
font-size: 18px;
*/
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
min-width:0;
}
