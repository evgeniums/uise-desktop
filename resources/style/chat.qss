uise--ChatMessageText uise--ChatMessageTextBrowser {
border-radius:0;
background-color: transparent;
border:none;
}

uise--AbstractChatMessageContent {
border-radius: 16px;
padding: 8px;
}

uise--AbstractChatMessage {
margin-top: 2px;
}

uise--AbstractChatMessage #bottomSpace{
min-height: 6px;
max-height: 6px;
}

uise--AbstractChatMessageContent[sent="true"] {
border-top-right-radius: 6px;
border-bottom-right-radius: 6px;
}

uise--AbstractChatMessageContent[sent="true"][first="true"] {
border-top-right-radius: 16px;
}

uise--AbstractChatMessageContent[sent="true"][last="true"] {
border-bottom-right-radius: 0;
}


uise--AbstractChatMessageContent[sent="false"] {
border-top-left-radius: 6px;
border-bottom-left-radius: 6px;
}

uise--AbstractChatMessageContent[sent="false"][first="true"] {
border-top-left-radius: 16px;
}

uise--AbstractChatMessageContent[sent="false"][last="true"] {
border-bottom-left-radius: 0;
}


uise--AbstractChatMessage uise--ChatMessageAvatar,
uise--AbstractChatMessage #avatarFrame{
min-width: 16px;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[sent="true"][last="true"] #mask{
border-radius:0;
border-bottom-left-radius: 16px;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[sent="false"][last="true"] #mask{
border-radius:0;
border-bottom-right-radius: 16px;
}

uise--AbstractChatSeparatorSection {
margin: 8px 0;
}

uise--AbstractChatSeparatorSection uise--AvatarButton {
padding: 5px 20px;
border-radius: 10px;
border: none;
}

uise--AbstractChatSeparatorSection uise--AvatarButton #text {
font-weight: bold;
}

/*
 * ChatDateSubtitle - floating date pill over the chat messages viewport.
 * Colours come from the uise--ChatSeparatorSection rules in light/chat.qss and dark/chat.qss,
 * inherited through the ChatSeparatorSection it wraps.
 */
uise--ChatDateSubtitle {
qproperty-showDelayMs: 150;
qproperty-hideDelayMs: 1200;
qproperty-fadeInDurationMs: 150;
qproperty-fadeOutDurationMs: 300;
qproperty-topOffset: 0;
background-color: transparent;
border: none;
}

uise--AbstractChatMessagesView #uiseFlyweightListViewV{
max-width: 1000px;
}

uise--AbstractChatMessageSelector {
min-width: 40px;
max-width: 40px;
}

uise--AbstractChatMessageBottom {
min-width: 90px;
}

uise--AbstractChatMessage {
qproperty-selectorPositionLeft: false;
min-width: 400px;
}

uise--AbstractChatMessage uise--ChatMessageSelector QCheckBox{
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector QCheckBox:hover{
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector QCheckBox::indicator{
width:14px;
height:14px;
border-radius: 9px;
}

uise--ChatMessageBottom uise--IconTextButton #icon,
uise--ChatMessageBottom uise--IconTextButton #text{
margin:0;
padding:0;
}

uise--ChatMessageBottom #status {
margin-left:8px;
margin-right:0;
}

uise--ChatMessageBottom uise--WithRoundedImage,
uise--ChatMessageBottom uise--RoundedImage {
min-width: 16px;
max-width: 16px;
min-height: 16px;
max-height: 16px;
}

uise--MessageSelectionPanelUi #drawer {
padding: 0 4px;
border-top-left-radius: 4px;
border-bottom-left-radius: 4px;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
margin: 0 6px;
padding: 6px 10px;
border-radius: 6px;
min-width:100px;
}

/* margin: 0 6px above grows this inner QPushButton's own rect() 6px wider on both left and
 * right -- rippleInsetLeft/Right compensate, keeping this in step with the margin above. */
uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton uise--RippleOverlay {
qproperty-rippleInsetLeft: 6;
qproperty-rippleInsetRight: 6;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
/*
font-size: 18px;
*/
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
min-width:0;
}
