uise--PasswordPanel uise--PasswordInput{margin: 8px 0px;}

uise--PasswordInput uise--PushButton QPushButton,
uise--PasswordDialog uise--PasswordInput uise--PushButton QPushButton,
uise--FrameWithModalStatus uise--PasswordInput uise--PushButton QPushButton,
uise--PasswordInput uise--PushButton QPushButton:hover,
uise--PasswordDialog uise--PasswordInput uise--PushButton QPushButton:hover,
uise--FrameWithModalStatus uise--PasswordInput uise--PushButton QPushButton:hover
{border: none; padding:0;}

uise--PasswordDialog uise--PasswordPanel {
margin-top: 8px;
}

uise--PasswordInput QLineEdit,
uise--PasswordInput PushButton
{margin: 0; padding 0;}

uise--PasswordInput #title{
margin-bottom: 6px;
}

uise--NewPasswordPanel {
padding:8px;
}

uise--NewPasswordDialog #currentPasswordInput {
padding:8px;
}

uise--NewPasswordPanel #buttonsFrame uise--IconTextButton {
border:none;
background-color:transparent;
padding:3px 0px;
margin-right:16px;
}

uise--NewPasswordPanel #buttonsFrame uise--IconTextButton #text {
text-decoration:underline;
}

/* margin-right:16px above grows this button's own rect() 16px wider on the right, and the
 * overlay is sized from that rect -- rippleInsetRight compensates so the ripple stops at the
 * visible button edge. Keep in step with the margin above.
 *
 * padding:3px 0px also makes these link-style buttons far shorter than the padded chrome
 * buttons ripple.qss's IconTextButton default was tuned for: at rippleRadiusScaleY 0.35 the
 * drawn ellipse never covers the host's full height and tapers to a point at both ends, so it
 * reads as an ellipse rather than filling the rounded clip. Equal X/Y scale draws a circle
 * reaching the farthest corner, so the "rounded" clip is filled completely and the effect reads
 * as a rounded rect around the text. */
uise--NewPasswordPanel #buttonsFrame uise--IconTextButton uise--RippleOverlay {
qproperty-rippleRadiusScaleX: 1.0;
qproperty-rippleRadiusScaleY: 1.0;
qproperty-rippleInsetRight: 16;
}

uise--NewPasswordPanel QLabel#error{
margin: 4px 0;
}

uise--NewPasswordPanel QLabel {
margin-left: 2px;
}

uise--NewPasswordWizard uise--PasswordInput
{
border-radius: 6px;
padding: 16px 20px 24px 20px;
}

uise--NewPasswordWizard uise--PasswordPanel
{
border-radius:4px;
}

uise--NewPasswordWizard QStackedWidget {
border:none;
padding:0;
}


#NewPasswordWizard QTextBrowser {
border:none;
margin:0;
border-radius: 0;
}

#NewPasswordWizard QStackedWidget {
margin-right:6px;
}
