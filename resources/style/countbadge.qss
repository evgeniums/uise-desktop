/*
 * CountBadge -- circle-to-pill counter badge (e.g. unread message count).
 * Neutral geometry (theme-agnostic). Colours live in light/countbadge.qss and dark/countbadge.qss.
 *
 * The badge's own size is derived in code from this QLabel's font and contentsMargins (padding),
 * never from the text it happens to hold -- so padding here controls the badge's fixed height and
 * its minimum circle diameter, not per-text spacing.
 */

uise--CountBadge > QLabel#badge {
    font-weight: normal;
    font-size: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 0px;
    padding-bottom: 0px;
    min-width: 8px;
    min-height: 17px;
}

/* IconBadge (a CountBadge floating over an icon's top-right corner): placement is computed against
   a virtual icon square of anchorSize, with the badge's right edge offsetX past it and its top
   offsetY above it. These are the C++ defaults, repeated here as the QSS tuning point. */
uise--IconBadge {
qproperty-anchorSize: 22;
qproperty-offsetX: 2;
qproperty-offsetY: 3;
}
