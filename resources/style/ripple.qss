/*
 * RippleOverlay configurable parameters. Colour lives in light/ripple.qss and
 * dark/ripple.qss -- everything else (geometry, timing, per-widget-type clip shape) is
 * theme-independent and declared here.
 *
 * qproperty-rippleEnabled         – false disables the effect entirely for the matched
 *                                   overlay, with no other C++/QSS change needed
 * qproperty-rippleOpacity         – peak alpha, as a 0-1 fraction of rippleColor's own alpha
 * qproperty-rippleDurationMs      – grow animation duration, ms
 * qproperty-rippleFadeDurationMs  – fade-out animation duration, ms
 * qproperty-rippleEasingCurveType – QEasingCurve::Type as int (6=OutCubic)
 * qproperty-rippleRadiusScaleX    – horizontal multiplier on the radius needed to just cover
 *                                   the widget from the origin; equal to rippleRadiusScaleY
 *                                   draws a true circle, unequal draws a flattened ellipse
 * qproperty-rippleRadiusScaleY    – vertical counterpart of rippleRadiusScaleX
 * qproperty-rippleHoldOnPress     – true: stay at full size while pressed, fade on release;
 *                                   false: fade immediately once the grow finishes
 * qproperty-rippleOrigin          – "cursor" (grows from the press point) | "center"
 * qproperty-rippleClip            – "rect" | "rounded" | "ellipse" | "capsule". Prefer
 *                                   "capsule" over "ellipse" for anything meant to look
 *                                   circular (icon-only, avatar-only, ...): a capsule's
 *                                   corner radius is always min(width,height)/2, so it's a
 *                                   true circle on a square rect and a clean straight-edged
 *                                   pill otherwise, whereas an inscribed ellipse tapers to a
 *                                   point at the extremes on anything not pixel-perfect
 *                                   square.
 * qproperty-rippleCornerRadius    – used when rippleClip is "rounded" (ignored by "capsule",
 *                                   which always computes its own); keep in step with the
 *                                   host's own border-radius, Qt does not expose a way to read
 *                                   that back in C++
 * qproperty-rippleInsetLeft/Top/Right/Bottom – shrinks the overlay within the host by this
 *                                   many px on that side (default 0, i.e. covers host->rect()
 *                                   exactly). Qt's box model makes a QSS "margin" on the host
 *                                   part of the host's own size, unlike CSS -- set these to
 *                                   match the host's own margin so the ripple stops at the
 *                                   border+padding+content box instead of growing into that
 *                                   (transparent) margin band. Same "Qt does not expose a way
 *                                   to read that back" caveat as rippleCornerRadius.
 *
 *                                   Only relevant when the ripple installs on the styled widget
 *                                   itself (IconTextButton, AvatarButton, CalendarDateRow,
 *                                   LoadControl -- see each widget's RippleOverlay::install()
 *                                   call): a margin on THAT widget grows its own rect(), which
 *                                   is what the overlay is sized from. It is a no-op for a
 *                                   wrapper that installs the ripple on an inner CHILD instead
 *                                   (PushButton -> its inner QPushButton/QToolButton, see
 *                                   pushbutton.hpp's styling contract) -- a margin on the
 *                                   wrapper never enlarges the child's own rect(), so the
 *                                   wrapper's margin can never reach the ripple and needs no
 *                                   inset compensation.
 */
uise--RippleOverlay {
    qproperty-rippleDurationMs:      150;
    qproperty-rippleFadeDurationMs:  50;
    qproperty-rippleEasingCurveType: 6;
}

/* IconTextButton covers the whole button, padding included (see icontextbutton.cpp) --
 * centred rather than cursor-origin, so the ripple is unaffected by where within the button
 * the press landed.
 *
 * Base case, applies whenever text is visible (iconOnly=="false", see the more specific rules
 * below for icon-only buttons and for AboveText/BelowText buttons): a wide, flat ellipse --
 * radiusScaleX close to 1 reaches the button's own left/right edges, radiusScaleY well under 1
 * keeps it from growing into a circle, so it reads as a horizontal sweep across the button
 * rather than a Material-style blob. Tuned for BeforeText/AfterText rows specifically -- see
 * the verticalLayout rule below for why AboveText/BelowText buttons need a different scale.
 * Clipped to "rounded" with a 4px corner radius, matching the FastSwitchButton/
 * AbstractDialog button chrome default elsewhere in this stylesheet set -- override
 * rippleCornerRadius alongside any QSS rule that gives an IconTextButton a different
 * border-radius. */
uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
    qproperty-rippleOrigin: "center";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 0.35;
}

/* AboveText/BelowText buttons (icon stacked over/under a caption -- e.g. AddContactInfo's
 * openChat/startCall/addContact, see icontextbutton.cpp's verticalLayout property) are much
 * closer to square than the horizontal BeforeText/AfterText rows the base rule above was tuned
 * for: the same 0.35 Y-scale there taps out well short of the button's actual height, so it
 * reads as a thin flattened band instead of a ripple that fills the button. Match the icon-only
 * treatment instead -- equal X/Y scale reaches every edge (padding included). */
uise--IconTextButton[iconOnly="false"][verticalLayout="true"] uise--RippleOverlay {
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

/* Icon-only buttons (no text -- see IconTextButton::setText()) get a circular halo instead:
 * clipped to a capsule, which -- because these buttons are typically styled square (see the
 * icon-only rules in demo/ripple/main.cpp) -- draws as a true circle, and equal X/Y radius
 * scale lets it grow larger than the icon itself and reach all the way to the button's own
 * edges (padding included), rather than staying pinned to the icon's own small bounds. Not
 * every icon-only IconTextButton ends up pixel-perfect square in practice (e.g. an asymmetric
 * QSS margin used to offset it within a row) -- capsule degrades to a straight-edged pill in
 * that case instead of an ellipse's tapered point, see ripple.hpp's Clip::Capsule doc. */
uise--IconTextButton[iconOnly="true"] uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

/* dayLabel is the round 28x28 day marker (border-radius: 14px in calendar.qss) -- a capsule
 * clip fits it exactly (true circle on this square label), and centering the ripple reads
 * better than a cursor-origin one on a cell this small. */
uise--CalendarDay uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleOrigin: "center";
}

/* CalendarDateRow (a row of the multiple-selection dates-management dropdown) covers its whole
 * row, matching its own 4px border-radius (see calendar.qss) -- left at rippleOrigin's default
 * ("cursor") since, unlike CalendarDay, there is no natural single point (e.g. an icon) to
 * centre on. */
uise--CalendarDateRow uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
}

/* DropdownMenu rows (see dropdownmenu.qss) are vertical list items, not toolbar buttons -- the
 * base IconTextButton rule above is tuned for a single BeforeText/AfterText button and flattens
 * to a thin horizontal band (radiusScaleY: 0.35), which reads as a partial, off-looking fill on
 * a full-width row. Match CalendarDateRow's full-row treatment instead: equal X/Y radius scale
 * (the RippleOverlay default) reaches every edge, top and bottom included, clipped to the row's
 * own 4px border-radius (see dropdownmenu.qss). More specific than the base IconTextButton
 * selector above (three compound selectors vs two), so it always wins outright instead of tying
 * on specificity. */
uise--DropdownMenu uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

/* FastSwitchButtonDropdown rows (see fastswitchbutton.qss) are the same kind of full-width
 * vertical list item as DropdownMenu's rows above, just a separate QSS class -- goToChats and
 * clearButton would otherwise fall through to the base IconTextButton rule and flatten to a
 * thin horizontal band. Same full-row treatment, matching the row's own 4px border-radius. */
uise--FastSwitchButtonDropdown uise--IconTextButton uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

/* PushButton wraps a real QPushButton/QToolButton (m_button) -- the ripple installs directly
 * on that inner widget (see pushbutton.cpp), which is the actual clickable element regardless
 * of how PushButton's own outer frame aligns/pads around it. Left at rippleOrigin's default
 * ("cursor") since PushButton has no fixed icon-only/text-only split to reason about the way
 * IconTextButton does -- a classic press-point ripple suits every combination it can show
 * (icon only, text only, or both). Clipped to "rounded" with the same 4px corner radius used
 * across the FastSwitchButton/AbstractDialog button chrome elsewhere in this stylesheet set --
 * override rippleCornerRadius alongside any QSS rule that gives a PushButton a different
 * border-radius.
 *
 * Styling contract (see pushbutton.hpp): the inner QPushButton/QToolButton owns padding/border/
 * border-radius/background -- it is the whole visible button, and this ripple fills its border
 * box exactly. A "margin" on the outer uise--PushButton frame (used for spacing between
 * adjacent buttons) never reaches this ripple, since the inner button is pinned to its sizeHint
 * -- do not add rippleInset* to compensate for it. */
uise--PushButton uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
}

/* AvatarButton mirrors IconTextButton's treatment exactly (see above) -- covers the whole
 * button, padding included, centred rather than cursor-origin.
 *
 * Base case, applies whenever text is visible (avatarOnly=="false", see the more specific rule
 * below for avatar-only buttons): the same wide, flat horizontal-sweep ellipse. */
uise--AvatarButton uise--RippleOverlay {
    qproperty-rippleClip: "rounded";
    qproperty-rippleCornerRadius: 4;
    qproperty-rippleOrigin: "center";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 0.35;
}

/* Avatar-only buttons (see AvatarButton::setAvatarOnly()) get a circular halo instead, same
 * reasoning as IconTextButton's icon-only rule -- avatars are round already (see avatar.qss),
 * so a capsule clip on a square avatar-only button draws as a true circle. */
uise--AvatarButton[avatarOnly="true"] uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}

/* LoadControl paints its own circle directly in paintEvent() rather than through a child
 * widget, so the ripple installs on the whole frame -- genuinely square (56x56, shared with
 * CircleBusy in loadcontrol.qss), so a capsule clip on it draws a true circle, same halo
 * treatment as an icon-only IconTextButton. Centred rather than cursor-origin to match. */
uise--LoadControl uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleOrigin: "center";
}

/* JumpEdge also paints its own circle directly in paintEvent() rather than through a child
 * widget, but unlike LoadControl is NOT square as a whole (flyweightlistview.qss pins it at
 * 44x64: a 44x44 circle at the bottom plus a strip above reserved for the optional badge
 * counter). The ripple installs on m_rippleArea, a plain child JumpEdge keeps sized to exactly
 * that bottom 44x44 sub-rect (see jumpedge.cpp) -- since THAT sub-widget genuinely is square,
 * the same capsule-clip halo treatment applies, without spilling into the badge strip. */
uise--JumpEdge uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleOrigin: "center";
}

/* AbstractCheckBox (CheckBox/RadioBox) installs the ripple on #indicator -- a deliberately
 * oversized, transparent container around the 20px indicator box (see checkbox.qss), so the
 * ripple reads as a Material halo around the box rather than a wash across the whole label.
 * #indicator is square, so "capsule" draws a true circle. Centred rather than cursor-origin
 * because the effect is driven from QAbstractButton::pressed()/released() with
 * RippleOverlay::setAutoTrigger(false) (see abstractcheckbox.cpp), not from mouse
 * coordinates -- a press on the text, and a Space-key activation, must both produce exactly
 * the same halo as a press on the box itself. */
uise--AbstractCheckBox uise--RippleOverlay {
    qproperty-rippleClip: "capsule";
    qproperty-rippleOrigin: "center";
    qproperty-rippleRadiusScaleX: 1.0;
    qproperty-rippleRadiusScaleY: 1.0;
}
