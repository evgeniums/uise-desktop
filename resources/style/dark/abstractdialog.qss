uise--AbstractDialog {background-color: #222222; border: 1px solid #777777;}
uise--AbstractDialog #dialogFrame QLabel {color: #999999;}
uise--AbstractDialog #titleFrame {background-color: #444444;}
uise--AbstractDialog #titleFrame QLabel {color:#FFFFFF;}

uise--AbstractDialog #dialogButtonsFrame uise--PushButton QPushButton{color: #CCCCCC;border: 1px solid #999999; background-color: transparent;}
uise--AbstractDialog #dialogButtonsFrame uise--PushButton QPushButton:hover{color: #EEEEEE;border: 1px solid #EEEEEE;}

/* Destructive action: set ButtonConfig::name="danger". Same colors as the Danger Zone buttons of the
 * Data folders page (whitemdesktop dark/datafolders.qss). Two ids so it outranks the generic rule. */
uise--AbstractDialog #dialogButtonsFrame uise--PushButton#danger QPushButton{color: #CC9999;border: 1px solid #AA7777; background-color: transparent;}
uise--AbstractDialog #dialogButtonsFrame uise--PushButton#danger QPushButton:hover{color: #EE6666;border: 1px solid #CC9999;}

uise--AbstractDialog #dialogButtonsFrame uise--PushButton QPushButton {min-width:80px;padding: 4px 12px;}
