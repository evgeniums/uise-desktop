/* Text inside a blockquote, kept in step with the `blockquote` colour in
   dark/messagetext.css so a quote reads the same in the composer and in the bubble it becomes.
   Applied through a QSyntaxHighlighter, so it never reaches the document and never leaks into the
   sent message -- see EnhancedTextEdit::setBlockquoteColor(). Being re-applied on every repolish
   is what makes a quote recolour on a theme switch instead of freezing at the colour it was
   typed in. */
uise--MessageEditor uise--EnhancedTextEdit {
qproperty-codeBlockColor: #D0D0D0;
qproperty-blockquoteColor: #BBBBBB;
/* Kept in step with dark/chat.qss's ChatMessageTextBrowser::linkColor/linkUnderline, so a link
   reads the same in the composer and in the bubble it becomes. Without this an inserted link is
   invisible AS a link -- Qt's layout draws an anchor exactly like ordinary text, and the blue an
   imported link used to show was baked into the document by Qt's own markdown importer, frozen at
   the theme it arrived in (and unreadable on this background). See
   EnhancedTextEdit::setLinkColor(). */
qproperty-linkColor: #7FB3F0;
qproperty-linkUnderline: false;
/* Task-message-formatting-plan.md, Stage 6: a mention reads as distinct from an ordinary link --
   a light violet against the link blue above, and legible on this background. Kept in step with
   dark/chat.qss's ChatMessageTextBrowser::mentionColor so a mention looks the same in the
   composer and in the bubble it becomes. See EnhancedTextEdit::setMentionColor(). */
qproperty-mentionColor: #E0C8FB;
/* Squiggle under a word no loaded dictionary accepts (task-spellcheck.md). Apple's own dark-mode
   systemRed -- brighter and more saturated than the light-mode value, matching how macOS itself
   shifts systemRed between appearances, and deliberately vivid rather than muted: this colour
   exists to be noticed. Theme colour, re-applied on every repolish -- see
   EnhancedTextEdit::setSpellCheckUnderlineColor(). Drawn by EnhancedTextEdit::paintEvent() now,
   not by a QTextCharFormat underline style -- see EnhancedTextEdit::SpellCheckUnderlineProperty
   for why. */
qproperty-spellCheckUnderlineColor: #FF453A;
/* Pen width of that squiggle, in device-independent pixels. Left at 0 ("auto") deliberately: auto
   is already platform-aware (EnhancedTextEdit::setSpellCheckUnderlineWidth()'s own doc comment) --
   2px round dots on macOS, where the native dotted style drew at the font's own lineThickness()
   (about one pixel, faint enough to read as a rendering artefact), and the font's own ~1px line
   width for the wave everywhere else. A non-zero value here applies to EVERY platform alike, which
   is what previously pinned this at 2 and made the Windows/Linux wave both twice as thick and
   twice as tall (drawSpellWave() ties amplitude to pen width) -- override only if a specific
   platform still needs tuning. */
qproperty-spellCheckUnderlineWidth: 0;
}

uise--MessageEditorToolbar {
border-bottom: 1px solid #444444;
}

uise--MessageEditorToolbar #separator {
background-color: #4A4A4A;
}

uise--MessageEditorToolbar uise--IconTextButton:hover,
uise--MessageEditor #leadingWidgets uise--IconTextButton:hover,
uise--MessageEditor #trailingWidgets uise--IconTextButton:hover {
background-color: #3A3A3C;
}

uise--MessageEditorToolbar uise--IconTextButton[checked="true"],
uise--MessageEditor #leadingWidgets uise--IconTextButton[checked="true"],
uise--MessageEditor #trailingWidgets uise--IconTextButton[checked="true"] {
background-color: #1E3A5C;
}

/* held mic button -- the darker blue of the waveform and the typing indicator */
uise--MessageEditor #micButton[checked="true"] {
background-color: #3a6ea5;
}
