/* AudioPlayerWidget -- dark theme colours. Same blues as the typing indicator and the waveform. */

uise--AudioPlayerWidget #titleLabel QLabel {
    color: #CCCCCC;
}

uise--AudioPlayerWidget #titleLabel[clickable="true"] QLabel {
    color: #8ec5ff;
}

/* A clickable title under the pointer: brighter, the step an accent-blue text takes on hover in
   this theme (dark/forwardpreview.qss's #actions text), plus the underline the calendar's own link
   button uses (dark/calendar.qss) -- so a text that goes somewhere when clicked reads as a link
   everywhere. The state is a dynamic property and not :hover -- it belongs to the whole
   ElidedLabel frame, padding included, while :hover would only match the inner label. */
uise--AudioPlayerWidget #titleLabel[clickable="true"][hovered="true"] QLabel {
    color: #FFFFFF;
    text-decoration: underline;
}

uise--AudioPlayerWidget #positionLabel,
uise--AudioPlayerWidget #durationLabel {
    color: #CCCCCC;
}

uise--AudioPlayerWidget #speedButton #text {
    color: #CCCCCC;
}

uise--AudioPlayerWidget #speedButton #text[hovered="true"] {
    color: #8ec5ff;
}

uise--DropdownFrame#volumeDropdown {
    background-color: #2B2B2B;
    border-color: #444444;
}

#volumePopup #volumeSlider::groove:vertical {
    background-color: #3a6ea5;
}

/*
 * The colours of WaveformBar: the selected level is drawn like the played part of a track (progress colour),
 * the rest like the part that is not played yet. The level is the part below the handle. It is add-page here
 * and sub-page in the first version of this sheet, which showed the two colours the wrong way round.
 */
#volumePopup #volumeSlider::add-page:vertical {
    background-color: #8ec5ff;
}

#volumePopup #volumeSlider::sub-page:vertical {
    background-color: #3a6ea5;
}

#volumePopup #volumeSlider::handle:vertical {
    background-color: #8ec5ff;
}
