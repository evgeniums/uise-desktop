/* Chat viewport background -- decoupled from the bubble tail now, see light/chat.qss's matching
 * comment for why. */
uise--AbstractChatMessagesView
{
background-color: #28282a; /* chat background */
background-image: url(":/uise/desktop/style/dark/chat_background.png");
background-repeat: repeat-xy;
}

uise--AbstractChatMessageContent {
background-color: #2d323b; /* received message */
}

uise--AbstractChatMessageContent[selected="true"],
uise--AbstractChatMessageContent[selected="true"][sent="true"]
{
background-color: #4A70A9; /* selected message */
}

uise--AbstractChatMessageContent[sent="true"] {
background-color: #355872; /* sent message */
}

uise--ChatMessageText uise--ChatMessageTextBrowser {
background-color: transparent;
border:none;
selection-background-color: #4A70A9; /* selected message */
qproperty-linkColor: #7FB3F0; /* task-urls-and characters-in-messages.md, Stage 1 */
qproperty-linkUnderline: false;
}

/* Jump-to-message highlight -- same tint as a reply block's own background (see
 * uise--AbstractChatMessageReply in dark/replypreview.qss: a plain white wash at 7% opacity),
 * matching light/chat.qss's identical choice of reusing the reply-block tint rather than a
 * distinct hue. */
uise--AbstractChatMessage {
qproperty-highlightColor: #FFFFFF;
qproperty-highlightOpacity: 0.07;
}

/* Tail colours, paired one-for-one with the bubble colours above -- see light/chat.qss's
 * matching comment for why these are qproperty-tailColor and deliberately not keyed on
 * [last="true"]. */
uise--AbstractChatMessage uise--ChatMessageAvatar[sent="false"] {
qproperty-tailColor: #2d323b;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="false"] {
qproperty-tailColor: #4A70A9; /* selected message */
}

uise--AbstractChatMessage uise--ChatMessageAvatar[sent="true"] {
qproperty-tailColor: #355872;
}

uise--AbstractChatMessage uise--ChatMessageAvatar[selected="true"][sent="true"] {
qproperty-tailColor: #4A70A9; /* selected message */
}

uise--ChatMessageBottom QLabel {
color: #888888;
font-size: 11px;
}

uise--ChatMessageBottom QLabel[sent="true"]{
color: #7AAACE;
}

uise--ChatMessageBottom QLabel[selected="true"],
uise--ChatMessageBottom QLabel[selected="true"][sent="true"]{
color: #9CD5FF;
}

uise--ChatSeparatorSection uise--AvatarButton,
uise--ChatSeparatorSection[separator_type="unread"] {
background-color:rgba(130,130,130,0.35);
}

uise--ChatSeparatorSection[separator_type="unread"] uise--AvatarButton {
background-color:transparent;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox:hover {
border:none;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff {
background-color: #CCC;
border: 2px solid #222;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn {
background-color: #4A70A9; /* selected message */
border: 2px solid #222;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOff[hovered="true"] {
border: 2px solid #CCC;
}

uise--AbstractChatMessage uise--ChatMessageSelector uise--CheckBox #indicatorOn[hovered="true"] {
border: 2px solid #4A70A9; /* selected message */
}

uise--MessageSelectionPanelUi #drawer {
background-color: #444444; /* node top frame */
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
background-color: #4A70A9; /* selected message */
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
background-color: transparent;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton {
color: #DDD;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton QPushButton:hover {
color: #FFFFFF;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton {
color: #8FABD4;
}

uise--MessageSelectionPanelUi #drawer uise--PushButton#cancel QPushButton:hover {
color: #EFECE3;
}

/* task-message-formatting-plan.md, Stage 4: the expand affordance floated over a table
   (structure in ../chat.qss). Deliberately low-contrast at rest so it does not compete with the
   message text it sits on top of, lifting to full contrast on hover. It keeps this treatment
   rather than the dialog-button one below -- it is an overlay on content, not a dialog control. */
/* Icons here are light (see chat.json's dark-mode currentColor), so the backing must be dark for
   contrast. OPAQUE for the same reason as the light theme's own rule -- see the comment there:
   over a table, translucency only lets cell borders and glyphs bleed through the button. Matches
   messagetext.css's own dark code-block surface, so overlay surfaces in a bubble share a tone.
   No :hover rule on purpose: the icon's own hovered colour is the feedback. */
uise--ChatMessageTextBrowser #tableExpandButton {
background-color: #2A2A2A;
}

/* The expanded viewer's own button row follows dark/abstractdialog.qss's button palette. Unlike
   the light theme, that file applies ONE outlined treatment to every button with no
   primary/secondary split, so Copy table is not singled out here either -- matching the dialogs
   is the point. Sizing matches that file's own values (min-width 80px, padding 4px 12px). */
#tableViewerFrame #tableViewerFullScreenButton QPushButton,
#tableViewerFrame #tableViewerCopyButton QPushButton,
#tableViewerFrame #tableViewerCloseButton QPushButton {
color: #CCCCCC;
border: 1px solid #999999;
background-color: transparent;
min-width: 80px;
padding: 4px 12px;
}
#tableViewerFrame #tableViewerFullScreenButton QPushButton:hover,
#tableViewerFrame #tableViewerCopyButton QPushButton:hover,
#tableViewerFrame #tableViewerCloseButton QPushButton:hover {
color: #EEEEEE;
border: 1px solid #EEEEEE;
}

/* FloatingDialogFrame is a translucent top-level window -- content that does not paint its own
   background shows straight through it (see docs/styling.md section 7). Without this the button
   row around the Copy table button is transparent. */
#tableViewerFrame {
background-color: #232323;
}


/* The code-block overlay strip. Same job as #tableExpandButton's fill above: mask the code behind
   it cleanly so the label and icon stay legible, without becoming a second visual element in its
   own right. The language label is deliberately quieter than the code it labels. */
uise--ChatMessageTextBrowser #codeBlockOverlay {
background-color: #3A3A3A;
}

uise--ChatMessageTextBrowser #codeBlockLanguage {
color: #A8A8A8;
}
