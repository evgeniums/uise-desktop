/*
 * WaveformBar – dark theme colours.
 *
 * qproperty-barColor      – bars (or track) not yet played (medium blue -- task-voice-messages-
 *                            plan.md S4f item 2: lightened from the original dim #3a6ea5 for more
 *                            contrast against the bubble background, still below progressColor)
 * qproperty-progressColor – bars (or track) already played, playhead and knob (bright light blue)
 * qproperty-cropColor     – crop handles
 */

uise--WaveformBar {
    qproperty-barColor:      #578cc4;
    qproperty-progressColor: #8ec5ff;
    qproperty-cropColor:     #8ec5ff;
}
