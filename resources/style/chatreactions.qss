/* Bubble section (6th ChatMessageContentSection slot, between comment() and bottom() -- see
   AbstractChatMessageContent::trailingSection()). maxBubbleWidth is this section's
   ownWidthCeiling() -- it must not be left unbounded, or a widened-for-reactions bubble could
   push past whatever cap a plain text body would already be held to; matches
   uise--AbstractChatMessageText's own cap so a message with both reads consistently. */
uise--ChatMessageReactions {
qproperty-maxBubbleWidth: 500;
}

/* ChatMessageReactionsRow packs chips itself (no QLayout -- see utils/flowpack.hpp); these are
   its only QSS-tunable knobs. maxVisibleChips: 0 means unlimited (no "..." overflow chip).
   maxAvatarChipTypes / maxAvatarsPerChip gate the avatars-vs-count presentation decision (see
   ChatMessageReactionsRow::setReactions()) -- default 2 reaction types, up to 3 users each. */
uise--ChatMessageReactionsRow {
qproperty-maxVisibleChips: 8;
qproperty-maxAvatarChipTypes: 2;
qproperty-maxAvatarsPerChip: 3;
qproperty-chipSpacing: 6;
qproperty-rowSpacing: 4;
/* width kept free at the end of the last chip row for an inline time/status row -- passed
   through to FlowPackOptions::reservedTailWidth */
qproperty-tailGap: 10;
}

/* padding/border declared unconditionally so the [own="true"] background below only changes
   colour, never the chip's box model -- same convention as dropdownmenu.qss's row rule */
uise--ChatMessageReactionChip {
padding:3px 8px;
border-radius:12px;
border:1px solid transparent;
/* Width, on each side, of the solid ring painted behind every avatar -- see #avatarRing's own
   comment. Its border-radius is NOT set here (it would need to track this property by hand);
   ChatMessageReactionChip::updateAvatars() computes and applies it in C++ instead. */
qproperty-avatarRingBorderWidth: 1;
}

uise--ChatMessageReactionChip #reactionIcon {
min-width:16px;
max-width:16px;
min-height:16px;
max-height:16px;
}

uise--ChatMessageReactionChip #avatars {
padding:0;
margin:0;
}

/* Matches #reactionIcon's own size (ChatMessageReactionChip's ReactionChipIconSize constant) --
   deliberately the same size so the icon and the avatar stack read as one consistent scale.
   Position AND overlap are both set in C++ (ChatMessageReactionChip::updateAvatars(), manual
   setGeometry() -- see that class's own comment on why neither a QSS margin nor
   QLayout::setSpacing() can express a genuine negative gap in Qt); these min/max-width rules are
   redundant with AvatarWidget::setAvatarSize()'s own setFixedSize() call, kept only as a
   self-documenting safety net. Do not add margin/position rules here -- they would be ignored. */
uise--ChatMessageReactionChip #avatar {
min-width:16px;
max-width:16px;
min-height:16px;
max-height:16px;
}

/* Solid backdrop painted behind each avatar (see updateAvatars()'s own comment on the layering
   trick this depends on) so overlapping same-coloured avatars still read as separate circles.
   Size is ReactionChipIconSize + 2*avatarRingBorderWidth on each axis. border-radius is
   deliberately NOT set here -- it would need to stay in sync with avatarRingBorderWidth by hand;
   ChatMessageReactionChip::updateAvatars() computes it from the property's CURRENT value and
   applies it per-instance instead, so the ring is always an exact circle regardless of that
   value. Colour is per-theme (see light/dark chatreactions.qss) since it approximates whatever
   surface the chip normally sits on, not a fixed brand colour. */
uise--ChatMessageReactionChip #avatarRing {
border:none;
}

uise--ChatMessageReactionChip #count {
margin-left:4px;
}

/* the trailing "..." overflow chip (ChatMessageReactionsRow::moreRequested()) shows only the
   dots glyph -- #reactionIcon/#count/#avatars all stay hidden, see setEllipsis(true) */
uise--ChatMessageReactionChip[ellipsis="true"] #moreIcon {
min-width:16px;
max-width:16px;
min-height:16px;
max-height:16px;
}

/* --- gallery quick bar (collapsed state: 7 basic icons + chevron) --- */

uise--ChatReactionQuickBar {
padding:4px;
}

/* PushButton's own styling contract (pushbutton.hpp): the INNER QPushButton owns padding/
   border/border-radius/background, the outer uise--PushButton wrapper supports only margin --
   padding/border declared on the outer frame is inert (its own layout margins are hard-reset to
   0 in its constructor). Emoji glyphs render via native QIcon (PushButton::setSvgIcon() ->
   QAbstractButton::setIcon()), sized with the QSS "icon-size" property, NOT a child
   uise--RoundedImage -- PushButton has no such child. */
uise--ChatReactionQuickBar #quickButton QPushButton {
icon-size:22px;
padding:4px;
border-radius:8px;
border:1px solid transparent;
}

uise--ChatReactionQuickBar #expandButton QPushButton {
icon-size:14px;
padding:2px;
border:none;
}

/* --- expanded gallery (recents row / search / scrollable grid) --- */

uise--ChatReactionGallery {
padding:8px;
}

uise--ChatReactionGallery #recentTitle {
margin-bottom:4px;
}

/* SearchLineEdit carries no padding of its own (lineedit.qss only styles its embedded action
   button icons), so without this the box's height is whatever Qt's platform style happens to give
   a bare QLineEdit -- cramped next to a grid of 22px icon cells. Vertical only: horizontal space
   is already spoken for by the built-in search/cancel action icons (SearchLineEdit's own
   addAction() calls).

   Applies to BOTH galleries. This used to be scoped to uise--EmojiGalleryDialog alone, on the
   theory that the compact reactions popup wanted a tighter box than the larger composer dialog;
   in practice the two just read as inconsistent, so there is now one shared height. */
uise--ChatReactionGallery #searchEdit {
margin-top:8px;
margin-bottom:8px;
padding-top:6px;
padding-bottom:6px;
}

/* How many icons the gallery packs into one ROW of its virtualized view
   (ChatReactionGallery::rebuildRows() chops each run of icons into rows of this many), and how
   many rows are visible before it scrolls. Both purely presentational, but galleryColumns is no
   longer only cosmetic: it is what the row PLAN is built from, so changing it rebuilds the plan.

   The column count is bounded by geometry this file does not own, so the reasoning matters more
   than the number:

   The panel takes its width from its widest child, which is the category tab strip -- one tab per
   category, ten in the default pack. The grid's rows then have to fit in that width MINUS the
   grid's own vertical scrollbar, which is subtracted from the viewport the rows lay out in. Sizing
   the rows to the panel's full width therefore overflows the viewport by exactly that scrollbar
   and the list grows a horizontal scrollbar underneath them, which is what 10 columns did.

   The strip's slack is what the rows live in, so the count follows from the cell pitch: a cell is
   its icon-size plus #galleryButton's padding and border, and the gap between cells is
   ReactionCellSpacing (src/chatreactiongallery.cpp, matched to the recent row above the grid --
   the two are read side by side).

   9 is the count that fills that slack most closely. It is also close enough to the edge that it
   was measured, not derived: the numbers involved (the platform scrollbar's width, what a polished
   PushButton actually reports) are not all knowable from this file. If a horizontal scrollbar
   appears under the rows, the rows have outgrown the viewport -- drop to 8 rather than trying to
   reclaim the difference elsewhere.

   Whatever the count, a band of dead space down the right of every row is the residue of all this
   and cannot be tuned away here: making the strip narrower so the GRID drives the panel width only
   moves the problem, since the rows would then be exactly as wide as the panel and the scrollbar
   would overflow them again. Removing it for real means deriving the count from the panel's live
   viewport width and rebuilding the row plan when it changes -- real machinery for a popup whose
   width never changes after it opens. If the pack's category count, the cell pitch or the cell
   spacing changes, redo the arithmetic above. */
uise--ChatReactionGallery {
qproperty-galleryColumns: 9;
qproperty-galleryVisibleRows: 5;
}

uise--ChatReactionGallery #galleryButton QPushButton {
icon-size:22px;
padding:4px;
border-radius:8px;
border:1px solid transparent;
}

/* --- BROWSE mode: category tab strip + the section headers carried by the first row of each
   category (ChatReactionGallery::rebuildRows()). The strip is shown whenever the search box is
   empty and the pack has categories() to offer; hidden for a search (no sections to jump
   between) and for a pack with no categories at all. --- */

uise--ChatReactionGallery #categoryTabs {
margin-top:4px;
margin-bottom:4px;
}

/* Deliberately smaller than #galleryButton's 22px -- a tab is a jump target, not a pick target,
   and nine of them side by side (the default pack's ten categories minus "Most common", which has
   no tab of its own -- browsing starts there already) should read as a compact strip, not another
   row of full-size gallery cells. */
uise--ChatReactionGallery #categoryTab QPushButton {
icon-size:16px;
padding:4px;
border-radius:6px;
border:1px solid transparent;
}

/* Category section title, e.g. "Smileys & Emotion" -- bold/muted rather than a new colour, per
   this project's "reuse accents" convention. It lives INSIDE the first row of its category (see
   ChatReactionGalleryRow), so it scrolls with the icons under it. Left margin lines it up with
   those icons (#galleryButton's 4px padding), not with the row's own edge. */
uise--ChatReactionGallery #sectionHeader {
font-weight:600;
margin-top:10px;
margin-bottom:4px;
margin-left:4px;
}

/* The very first row's header ("Most common") sits directly under the search box/tab strip -- no
   extra top margin needed there, unlike every section after it. A dynamic property, not a
   structural selector: Qt Style Sheets has no :first-child (that is CSS3, not part of Qt's
   supported pseudo-state list, which is widget STATES only -- :hover, :checked and similar).
   ChatReactionGalleryRow sets this property on row 0's header only, matching the same
   [property="value"] idiom this file already uses for #reactionIcon's [ellipsis="true"]. */
uise--ChatReactionGallery #sectionHeader[firstSection="true"] {
margin-top:0;
}

/* --- the grid's jump-to-home control (JumpEdge, shown by FlyweightListView once scrolled away
   from the top) --- */

/* Its default 44x64 (flyweightlistview.qss) is sized for a chat messages view, where it floats
   over full-width bubbles; over a grid whose entire cells are ~30px it reads as an oversized
   blob. Written as a descendant selector so BOTH galleries pick it up -- the composer picker's
   content IS a ChatReactionGallery (see #emojiGallery below) -- while every other
   FlyweightListView in the app keeps the default.

   The radius is NOT a border-radius property here: JumpEdge paints its circle itself in
   paintEvent() and takes the diameter from the widget's WIDTH, so the width below is what
   controls it -- 32px wide means a 16px radius, down from 22px. The height is that circle plus
   the strip JumpEdge reserves above it for an optional badge counter; a gallery never shows one,
   so only a small strip is kept. */
uise--ChatReactionGallery uise--JumpEdge {
min-width:32px;
max-width:32px;
min-height:40px;
max-height:40px;
}

/* Icon size, likewise not an icon-size property: paintEvent() derives the glyph width as the
   frame width minus twice this #sample min-width, which it reads as the icon's base padding --
   the property is reused as a plain numeric channel because JumpEdge exposes no QSS icon metric
   of its own (see paintEvent()'s own comment on encoding its parameters this way). 6px against
   the 32px frame above gives a 20px glyph, a little under the 22px of the gallery's own cells,
   which is the right relative weight for an overlay control.

   padding MUST be kept equal to min-width above, or the glyph stops being centred in the circle.
   paintEvent() insets the icon by min-width on the axis it is not pointing along, and by the
   padding on the side it points at (m.top() for an Up chevron, m.left() for a Left one), so the
   gap on one side is the padding and the gap on the other is 2*min-width minus that padding --
   equal only when the two values match. The base rule's own 4px/4px pair is self-consistent for
   the same reason; raising min-width alone left the Up chevron sitting 2px low. All four sides are
   set so the invariant holds whichever edge the control is pointing at. */
uise--ChatReactionGallery uise--JumpEdge #sample {
min-width:6px;
padding:6px;
}

/* --- the dropdown frame hosting both quick-bar and gallery panels --- */

uise--ChatReactionGalleryDropdown {
padding:0;
border:1px solid;
border-radius:8px;
qproperty-offsetX: 0;
qproperty-offsetY: 4;
qproperty-animationDurationMs: 150;
qproperty-easingCurveType: 6;
}

/* --- the floating emoji picker (EmojiGalleryDialog) --- */

/* The frame's own fade is the last of the three things between hovering the emoji button and
   seeing the gallery (the other two being MessageEditor::EmojiHoverOpenDelayMs and, on the very
   first open only, building the dialog -- which MessageEditor::warmEmojiGallery() now does ahead
   of time). FloatingDialogFrame defaults to 150ms, which is right for a dialog the user opened
   deliberately and too slow for one that is supposed to follow the pointer. Not 0: an instant
   appearance of something this large is jarring, and 90ms still reads as immediate. */
uise--FloatingEmojiGalleryDialog {
qproperty-fadeDurationMs: 90;
}

/* The dialog's content IS a ChatReactionGallery, so everything above already styles the grid,
   the search box and the recents row. Only the dialog's own chrome needs anything here. */

/* EmojiGalleryDialog::construct() calls setButtons({}), which leaves Dialog<>'s buttons frame in
   the layout with nothing in it. Without this it still reserves whatever padding abstractdialog.qss
   gives a button row -- a strip of blank space under the grid with no buttons in it. */
uise--EmojiGalleryDialog #dialogButtonsFrame {
margin:0;
padding:0;
min-height:0px;
max-height:0px;
}

/* Originally sized so the WHOLE default pack (then 54 icons) fit with no scrolling at all, which
   the reactions dropdown's own grid did not. That no-scroll property no longer holds now that the
   default pack is ~1374 icons across ten categories (see ChatReactionGallery::rebuildRows()) --
   BROWSE mode is expected to scroll, the same way any category-sectioned picker does.

   Only the ROW COUNT is still overridden here. The column count is not: this dialog used to ask
   for one more column than the reactions popup, for a "a dialog the user opens to browse" versus
   "a compact popup anchored to a message bubble" distinction, but both panels take their width
   from the same widest child -- the ten-category tab strip -- so the right count is a property of
   that strip, not of which host is showing the gallery. Both now inherit it from
   uise--ChatReactionGallery above; this dialog stays the roomier of the two on the axis where that
   is actually free, showing 6 rows before it scrolls rather than 5. */
/* Bottom corners: #dialogButtonsFrame above is squashed to zero height for this dialog, so unlike
   every other uise--AbstractDialog (where a real, background-less buttons row sits between the
   content and the dialog's own bottom edge, letting THAT edge's rounded corner show through on
   its own) #emojiGallery's own opaque background (uise--ChatReactionGallery's background-color,
   dark/chatreactions.qss and light/chatreactions.qss) now sits flush against the dialog's bottom
   edge. Needs its own matching radius for the same reason #titleFrame above needs one at the top
   -- an opaque child flush against a rounded container's edge paints its own square corner over
   it otherwise. 7px, one less than uise--AbstractDialog's own 8px border-radius, nests inside
   that 1px border exactly as #titleFrame's own top radius already does. */
uise--EmojiGalleryDialog #emojiGallery {
margin:0;
padding:0;
border-bottom-left-radius:7px;
border-bottom-right-radius:7px;
qproperty-galleryVisibleRows: 6;
}

/* The search box's own vertical padding now lives on uise--ChatReactionGallery #searchEdit, which
   both galleries share -- it was here, scoped to this dialog, until the reactions popup was made
   to match it. */
